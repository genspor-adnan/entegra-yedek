  object TabSatis: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'CIKFATBASID'
        Attributes = [paSigned, paNullable]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        '    SELECT SI.ID AS TABLOSTOKID,FB.TARIH as FATURATARIH,FB.FATUR' +
        'ANO,FB.BASLIK,K.*,SI.URUNBARKOD,K.MALSATILANGLN,'
      
        '    SI.SIRANO,SI.LOTNO,SI.SONKULLANIM,K.SATIS_DURUM,SI.PAKETID,S' +
        'I.CIKFATBASID,'
      
        '    CASE WHEN (SUBSTRING(ISNULL(SATIS_DURUM,0),1,5)='#39'00000'#39')   O' +
        'R (SUBSTRING(ISNULL(SATIS_DURUM,0),1,5)='#39'10204'#39')  THEN 0 ELSE  1' +
        ' END  AS DURUM'
      '    FROM FATBASLIK FB '
      '    INNER JOIN STOKID SI ON FB.ID = SI.CIKFATBASID'
      '    INNER JOIN KAREKOD K ON K.STOKIDID = SI.ID'
      '    WHERE  SI.CIKFATBASID =:CIKFATBASID')
    Left = 483
    Top = 144
    object TabSatisFATURATARIH: TDateTimeField
      FieldName = 'FATURATARIH'
    end
    object TabSatisBASLIK: TWideStringField
      FieldName = 'BASLIK'
