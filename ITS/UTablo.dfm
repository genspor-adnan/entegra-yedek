  object TabBizim: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      ''
      'Declare @IletisimID integer'
      'select @IletisimID = ID from REHBERILETISIM where REHBERID=-1'
      'select'
      
        'KOD,FIRMA,GRUP,KATEGORI,DURUM,OZELKOD,ARAMADACIKSIN,NOTLAR,YETKI' +
        'KODU,'
      
        'ISTEL=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOI' +
        'N REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA' +
        '.YERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=40),'
      
        'CEP=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN ' +
        'REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.Y' +
        'ERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=42),'
      
        'FAX=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN ' +
        'REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.Y' +
        'ERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=43),'
      
        'ADRES=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOI' +
        'N REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA' +
        '.YERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=2),'
      
        'ILCE=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN' +
        ' REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.' +
        'YERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=6),'
      
        'IL=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN R' +
        'EHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.YE' +
        'RI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=8),'
      
        'PK=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN R' +
        'EHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.YE' +
        'RI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=4),'
      
        'VERGIDAI=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER ' +
        'JOIN REHBERAYAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA AND' +
        ' RA.YERI=RB.YERI WHERE RB.YER_ID=-1 AND RA.VARSAYILAN=20),'
      
        'VERGINO=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER J' +
        'OIN REHBERAYAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA AND ' +
        'RA.YERI=RB.YERI WHERE RB.YER_ID=-1 AND RA.VARSAYILAN=22),'
      
        'WEB=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN ' +
        'REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.Y' +
        'ERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=48),'
      
        'EMAIL=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOI' +
        'N REHBERAYAR RA (nolock) ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA' +
        '.YERI=RB.YERI WHERE RB.YER_ID=@IletisimID AND RA.VARSAYILAN=46),'
      
        'FATURABASLIK=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) IN' +
        'NER JOIN REHBERAYAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA' +
        ' AND RA.YERI=RB.YERI WHERE RB.YER_ID=-1 AND RA.VARSAYILAN=10),'
      
        'LOGO= (SELECT TOP 1 BELGE FROM IMAJ I WHERE VARSAYILAN=1 AND YER' +
        'I=11 AND YER_ID=-1 ),'
      
        'VERGIDAI_KODU=(select TOP 1 VDKODU FROM VDLISTE VD WHERE VD.VD =' +
        '(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN REHB' +
        'ERAYAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA AND RA.YERI=' +
        'RB.YERI WHERE RB.YER_ID=-1 AND RA.VARSAYILAN=20)),'
      
        'VERGI=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOI' +
        'N REHBERAYAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA AND RA' +
        '.YERI=RB.YERI WHERE RB.YER_ID=-1 AND RA.VARSAYILAN=20)+'#39' / '#39'+(SE' +
        'LECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) INNER JOIN REHBERA' +
        'YAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA AND RA.YERI=RB.' +
        'YERI WHERE RB.YER_ID=-1 AND RA.VARSAYILAN=22)'
      'from'
      'REHBER R'
      'WHERE ID = -1')
    Left = 671
    Top = 64
