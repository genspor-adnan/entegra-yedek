  object TabYetki: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'PKOD'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'select Y.MODULID,Y.HAK,Y.BILGI,Y.TUR, K.KOD,Y.ROLID'
      'FROM '
      #9'YETKI Y INNER JOIN '
      #9'KULLANICI K ON '
      #9#9'Y.ROLID=K.ROLID'
      'WHERE K.ID = :PKOD')
    Left = 21
    Top = 232
  end
