  object TabMalAlim: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT TOP 1 FB.TARIH as FATURATARIH ,FB.BASLIK,FB.FATURANO,K.*,' +
        'SI.URUNBARKOD,SI.SIRANO,SI.LOTNO,SI.SONKULLANIM,'
      
        ' CASE WHEN (SUBSTRING(ISNULL(ALIM_DURUM,0),1,5)='#39'00000'#39')   OR (S' +
        'UBSTRING(ISNULL(ALIM_DURUM,0),1,5)='#39'10204'#39')  THEN 0 ELSE  1 END ' +
        ' AS DURUM'
      ' FROM KAREKOD K,FATBASLIK FB , STOKID SI'
      
        ' WHERE (ALIM_DURUM IS NULL) OR (ALIM_DURUM ='#39#39') AND SI.GIRFATBAS' +
        'ID = FB.ID AND SI.ID=K.STOKIDID')
    Left = 483
    Top = 8
    object TabMalAlimFATURATARIH: TDateTimeField
      FieldName = 'FATURATARIH'
    end
    object TabMalAlimBASLIK: TWideStringField
      FieldName = 'BASLIK'
      Size = 100
    end
    object TabMalAlimFATURANO: TWideStringField
      FieldName = 'FATURANO'
      Size = 10
    end
