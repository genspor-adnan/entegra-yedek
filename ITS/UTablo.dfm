  object TabUretim: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'GIRFATBASID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end
      item
        Name = 'GIRFATURAID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT SI.SEC,IU.TARIH as BELGETARIH,IU.BELGENO,SI.ID,SI.URUNBAR' +
        'KOD,SI.SIRANO,SI.LOTNO,SI.SONKULLANIM,SUBSTRING(CONVERT(VARCHAR(' +
        '10),SI.SONKULLANIM,112),3,6) AS BARKODTARIH,'
      
        'K.URETIM_DURUM,K.URETIM_BILDIRIM_TARIH,K.MALALINANGLN,K.MALSATIL' +
        'ANGLN,K.TRANSFERID '
      
        ',SI.URETIMTIPI,SI.URUNCINSI,SI.URETIMTARIHI,SI.URUNNO  FROM KARE' +
        'KOD K,STOKID SI,ITS_URETIM IU   WHERE (SI.ID=K.STOKIDID) AND (SI' +
        '.GIRFATBASID = IU.BELGEBASID) '
      'AND (SI.GIRFATURAID = IU.BELGEDETAYID) '
      
        'AND SI.GIRFATBASID =:GIRFATBASID AND SI.GIRFATURAID =:GIRFATURAI' +
        'D ')
    Left = 483
    Top = 327
