  object TabAlisBelgeListesi: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT F.ID AS FID,FB.ID AS FBID,FB.TARIH,FB.REHBERID,FB.FATURAN' +
        'O AS BELGENO,R.FIRMA,RI.ANAHTAR,RI.ANAHTAR AS BELGETIPI,S.STOKAD' +
        'I,F.ADET,FB.TUR,F.URUNID,B.ID AS BARKODID,FB.GIRISDEPO  FROM  '
      'FATBASLIK FB '
      'INNER JOIN FATURA F ON F.FATBASID=FB.ID AND F.IZLEME = 3 '
      'INNER JOIN REHBER R ON R.ID = F.REHBERID  '
      
        'INNER JOIN REHBERINI RI ON RI.BOLUM = '#39'Kasa T'#252'rleri'#39' AND RI.DEGE' +
        'R=FB.TUR'
      
        'INNER JOIN STOKBARKOD B ON B.STOKID = F.URUNID AND B.VARSAYILAN=' +
        '1'
      'INNER JOIN STOKLAR S ON S.ID=F.URUNID ')
    Left = 675
    Top = 120
    object TabAlisBelgeListesiFID: TAutoIncField
      FieldName = 'FID'
      ReadOnly = True
    end
    object TabAlisBelgeListesiFBID: TAutoIncField
      FieldName = 'FBID'
      ReadOnly = True
    end
