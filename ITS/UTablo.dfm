  object TabListeler: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'SELECT SUM(PAKET) AS PAKET,SUM(URETIM) AS URETIM,SUM(SATIS) AS S' +
        'ATIS  FROM (SELECT count(SD.ID) AS PAKET ,0 AS URETIM,0 AS SATIS' +
        ' FROM  SIPARISDETAY SD'
      '  '#9'INNER JOIN SIPARIS SB ON SD.SIPARISID=SB.ID AND SD.IZLEME = 3'
      
        '    INNER JOIN STOKBARKOD B ON B.STOKID = SD.URUNID AND B.VARSAY' +
        'ILAN=1  '
      
        '   WHERE (SB.TUR = 19) AND SD.ID NOT IN (SELECT ISNULL(SIPARISDE' +
        'TAYID,0) FROM ITS_PAKET ) '
      '   UNION ALL'
      'SELECT 0,COUNT(F.ID) AS URETIM,0  FROM  FATBASLIK FB'
      '  '#9'   INNER JOIN FATURA F ON F.FATBASID=FB.ID AND F.IZLEME = 3'
      
        '       INNER JOIN STOKBARKOD B ON B.STOKID = F.URUNID AND B.VARS' +
        'AYILAN=1  '
      '   WHERE FB.TUR = 11'
      
        '  AND F.ID NOT IN (SELECT ISNULL(BELGEDETAYID,0) FROM ITS_URETIM' +
        ' )'
      ' UNION ALL  '
      
        'SELECT 0,0,COUNT(ID) AS SATIS FROM (SELECT FB.ID, ISNULL(IB.DURU' +
        'M,1) AS SATISDURUM,'
      
        '(SELECT SUM(ADET) FROM FATURA F INNER JOIN STOKLAR S ON F.URUNID' +
        '=S.ID AND S.IZLEME=3 '
      'WHERE F.FATBASID=FB.ID) AS ADET '
      
        'FROM FATBASLIK FB  LEFT OUTER JOIN ITS_BILDIRIM IB ON IB.YERI = ' +
        '3 AND IB.YERID = FB.ID'
      'WHERE (FB.TUR = 14 OR FB.TUR = 15)  ) AS DD'
      'WHERE ISNULL(DD.ADET,0)<>0 AND SATISDURUM = 1 ) AS DD')
    Left = 272
    Top = 416
    object TabListelerPAKET: TIntegerField
      FieldName = 'PAKET'
      ReadOnly = True
    end
    object TabListelerURETIM: TIntegerField
      FieldName = 'URETIM'
      ReadOnly = True
    end
    object TabListelerSATIS: TIntegerField
      FieldName = 'SATIS'
      ReadOnly = True
    end
  end
