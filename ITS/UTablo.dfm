  object TabSatisIptal: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'GIRFATURAID'
        Attributes = [paSigned]
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        '    SELECT FB.TARIH as FATURATARIH,FB.FATURANO,FB.BASLIK,K.*,SI.' +
        'URUNBARKOD,K.MALALINANGLN,'
      
        '    SI.SIRANO,SI.LOTNO,SI.SONKULLANIM,K.SATIS_DURUM,SI.PAKETID,S' +
        'I.GIRFATBASID,'
      
        '    CASE WHEN (SUBSTRING(ISNULL(SATIS_IPTAL_DURUM,0),1,5)='#39'00000' +
        #39')   OR (SUBSTRING(ISNULL(SATIS_IPTAL_DURUM,0),1,5) IN ('#39'10204'#39',' +
        #39'10223'#39'))  THEN 0 ELSE  1 END  AS DURUM'
      '    FROM FATBASLIK FB '
      '    INNER JOIN STOKID SI ON FB.ID = SI.GIRFATBASID'
      '    INNER JOIN KAREKOD K ON K.STOKIDID = SI.ID'
      '    WHERE  SI.GIRFATURAID =:GIRFATURAID')
    Left = 483
    Top = 190
