  object TabStatus: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabStatusAfterOpen
    AfterScroll = TabStatusAfterScroll
    Parameters = <>
    SQL.Strings = (
      'Select P.PERKOD,P.ADI,P.SOYADI,P.DEPARTMAN,PK.*,'
      'dbo.fn_GIRCIK(PK.CIKIS) AS GIRCIK,'
      'GIRIS2=SUBSTRING(CONVERT (VARCHAR(20),PK.GIRIS),13,5),'
      'GIRFARK=SUBSTRING(dbo.fn_GIRFARK(VARGIRIS,GIRIS),7,3),'
      
        'CIKFARK=SUBSTRING(dbo.fn_CIKFARK(VARGIRIS,VARCALSURE,GIRIS,CIKIS' +
        '),7,5),'
      'GEC_MAZERET,ERKEN_MAZERET'
      'from PER_SABIT P,PERS_PDKS PK '
      'where '
      
        'PK.PERKOD=P.PERKOD and ((datepart(m,GIRIS)=datepart(m,GETDATE())' +
        ' and '
      'datepart(d,GIRIS)=datepart(d,GETDATE()) and '
      
        'datepart(yy,GIRIS)=datepart(yy,GETDATE())) OR (datepart(m,CIKIS)' +
        '=datepart(m,GETDATE()) and '
      'datepart(d,CIKIS)=datepart(d,GETDATE()) and '
      'datepart(yy,CIKIS)=datepart(yy,GETDATE())))'
      'ORDER BY GIRIS,CIKIS'
      '')
    Left = 296
    Top = 112
  end
