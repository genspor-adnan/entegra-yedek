    Label4: TLabel;
    txtPortNo: TEdit;
    TabSheet3: TTabSheet;
    Label5: TLabel;
    Label6: TLabel;
    Label7: TLabel;
    Label8: TLabel;
    SpeedButton1: TSpeedButton;
    txtSGiris: TEdit;
    SpeedButton2: TSpeedButton;
    txtSCikis: TEdit;
    SpeedButton3: TSpeedButton;
    txtSSure: TEdit;
