  object TabKullan: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'select K.ID,K.REHBERID,K.SIFRE,K.KOD,K.ROLID,K.DURUM,R.FIRMA '
      
        '                            from REHBER R inner join KULLANICI K' +
        ' on K.REHBERID=R.ID where R.DURUM=1 and K.DURUM=1 order by 1')
