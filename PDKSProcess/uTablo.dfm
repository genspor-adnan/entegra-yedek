  object TabStatus: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabStatusAfterOpen
    AfterScroll = TabStatusAfterScroll
    Parameters = <>
    SQL.Strings = (
      ''
      'Select R.ID,R.FIRMA,PP.*,'
      'dbo.fn_GIRCIK(PP.CIKIS) AS GIRCIK,'
      'VARGIRIS = dbo.fn_SaatOlarak(DBO.fn_DakikaTarihten(PV.GIRIS)),'
      'VARCIKIS = dbo.fn_SaatOlarak(DBO.fn_DakikaTarihten(PV.CIKIS))'
      'from PERS_PDKS PP '
      'left outer join REHBER R on PP.REHBERID=R.ID'
      
        'left outer join PERS_VARDIYATANIM PV on PV.REHBERID=PP.REHBERID ' +
        'and PV.GUN=DATEPART(WEEKDAY,PP.GIRIS)'
      'where '
      
        'datepart(m,PP.GIRIS) = datepart(m,GETDATE()) and datepart(d,PP.G' +
        'IRIS)=datepart(d,GETDATE()) and '
      'datepart(yy,PP.GIRIS)=datepart(yy,GETDATE()) '
      'and PV.AY = 0 and PP.REHBERID <> 0 '
      ''
      'union all'
      ''
      'Select R.ID,R.FIRMA,PP.*,'
      'dbo.fn_GIRCIK(PP.CIKIS) AS GIRCIK,'
      'VARGIRIS = dbo.fn_SaatOlarak(DBO.fn_DakikaTarihten(PV.GIRIS)),'
      'VARCIKIS = dbo.fn_SaatOlarak(DBO.fn_DakikaTarihten(PV.CIKIS))'
      'from PERS_PDKS PP '
      'left outer join REHBER R on PP.REHBERID=R.ID'
      
        'left outer join PERS_VARDIYATANIM PV on PV.REHBERID=PP.REHBERID ' +
        'and PV.GUN=DATEPART(DAY,PP.GIRIS) and PV.AY=DATEPART(MONTH,PP.GI' +
        'RIS)'
      'where '
      
        'datepart(m,PP.GIRIS) = datepart(m,GETDATE()) and datepart(d,PP.G' +
        'IRIS)=datepart(d,GETDATE()) and '
      'datepart(yy,PP.GIRIS)=datepart(yy,GETDATE())'
      'and PV.AY <> 0 and PV.YIL <> 0 and PP.REHBERID <> 0'
      ''
      'ORDER BY PP.GIRIS,PP.CIKIS')
    Left = 304
    Top = 136
  end
  object DtsStatus: TDataSource
    DataSet = TabStatus
    Left = 304
    Top = 184
  end
