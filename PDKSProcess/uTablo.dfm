  object TabKimlik: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterScroll = TabKimlikAfterScroll
    Parameters = <>
    SQL.Strings = (
      
        'Select P.PERKOD,P.ADI,P.SOYADI,P.DEPARTMAN,PK.*,dbo.fn_GIRCIK(PK' +
        '.CIKIS) AS GIRCIK'
      'from PER_SABIT P,PERS_PDKS PK where '
      
        'PK.PERKOD=P.PERKOD and ((datepart(m,GIRIS)=datepart(m,GETDATE())' +
        ' and '
      'datepart(d,GIRIS)=datepart(d,GETDATE()) and '
      
        'datepart(yy,GIRIS)=datepart(yy,GETDATE())) OR (datepart(m,CIKIS)' +
        '=datepart(m,GETDATE()) and '
      'datepart(d,CIKIS)=datepart(d,GETDATE()) and '
      'datepart(yy,CIKIS)=datepart(yy,GETDATE())))'
      'ORDER BY GIRIS,CIKIS'
      '')
    Left = 88
    Top = 40
  end
