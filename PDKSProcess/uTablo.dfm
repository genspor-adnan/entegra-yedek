  object TabYetki: TADOQuery
    Connection = cnn
    Parameters = <
      item
        Name = 'PRolID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'declare @RolID int'
      'set @RolID=:PRolID'
      'select Y.MODULID,Y.TUR,ROLID=@RolID,Y.HAK,YE.BILGI'
      'FROM '
      #9'YETKI Y   LEFT OUTER JOIN'
      #9'YETKIEK YE ON'
      #9#9'YE.MODULID=Y.MODULID '
      
        'WHERE isnull(Y.ROLID,@RolID)=@RolID and isnull(YE.ROLID,@RolID)=' +
        '@RolID ')
    Left = 56
    Top = 205
  end
