  object TabYemekhane: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'Select '
      #9'P.PERKOD,P.ADI,P.SOYADI,P.DEPARTMAN,PK.*'
      'from '
      #9'PER_SABIT P,PERS_YEMEKHANE PK where '
      'PK.PERKOD=P.PERKOD and '
      '((datepart(m,SABAH)=datepart(m,GETDATE()) and '
      'datepart(d,SABAH)=datepart(d,GETDATE()) and '
      'datepart(yy,SABAH)=datepart(yy,GETDATE())) '
      ''
      'OR '
      '(datepart(m,OGLEN)=datepart(m,GETDATE()) and '
      'datepart(d,OGLEN)=datepart(d,GETDATE()) and '
      'datepart(yy,OGLEN)=datepart(yy,GETDATE()))'
      ''
      'OR'
      ''
      '(datepart(m,AKSAM)=datepart(m,GETDATE()) and '
      'datepart(d,AKSAM)=datepart(d,GETDATE()) and '
      'datepart(yy,AKSAM)=datepart(yy,GETDATE()))'
      ''
      ')'
      ''
      'ORDER BY SABAH,OGLEN,AKSAM')
    Left = 488
    Top = 128
  end
