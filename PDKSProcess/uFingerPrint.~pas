function ToplamBul(hexcode: string): string;
var
  i: integer;
  str: string;
  sonuc: integer;
begin
  str := hextostr(trim(hexcode));
  sonuc := 0;
  for i := 1 to length(str) do
    sonuc := sonuc + Ord(str[i]);
  sonuc := sonuc mod 256;
  Result := IntToHex(sonuc, 2);
end;

