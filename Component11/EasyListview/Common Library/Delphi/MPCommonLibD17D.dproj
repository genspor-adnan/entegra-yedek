<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7255551b-c190-4b07-a924-d6fcf6d68c9c}</ProjectGuid>
        <MainSource>MPCommonLibD17D.dpk</MainSource>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <DCC_DCCCompiler>DCC32</DCC_DCCCompiler>
        <DCC_DependencyCheckOutputName>..\..\..\bpl\MPCommonLibD11D.bpl</DCC_DependencyCheckOutputName>
        <ProjectVersion>19.5</ProjectVersion>
