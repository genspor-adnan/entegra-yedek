        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <Icon_MainIcon>MPCommonLibD11D_Icon.ico</Icon_MainIcon>
        <DCC_UsePackage>vclx;vcl;rtl;vclactnband;$(DCC_UsePackage)</DCC_UsePackage>
