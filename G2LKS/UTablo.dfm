    DataSet = TabCariler
    Left = 130
    Top = 400
  end
  object TabCariler: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabCarilerAfterOpen
    Parameters = <
      item
        Name = 'PBasla'
        Size = -1
        Value = Null
      end
      item
        Name = 'PBit'
        DataType = ftWideString
        Size = 19
        Value = Null
      end>
    SQL.Strings = (
      'DECLARE @BASLANGIC datetime'
      'DECLARE @BITIS datetime'
      ''
      'SET @BASLANGIC=:PBasla'
      'SET @BITIS=:PBit'
      ''
      'select'
      '      ID,'
      '      KOD=SUBSTRING(KOD,1,30),'
      '      FIRMA=SUBSTRING(FIRMA,1,50),'
      '      SINIF,'
      '      MUHAKTAR,'
      '      MUHKODU,'
      '      ISTEL=SUBSTRING(ISTEL,1,15),'
      '      CEP=SUBSTRING(CEP,1,15),'
      '      FAX=SUBSTRING(FAX,1,15),'
      '      VNO=SUBSTRING(cast(VNO as varchar(20)),1,15),'
      '      VD=SUBSTRING(VD,1,20),'
      '      VDNO=SUBSTRING(cast(VDNO as varchar(20)),1,20),'
      '      ADRES=SUBSTRING(ADRES,1,40),'
      '      ILCE=SUBSTRING(ILCE,1,20),'
      '      IL=SUBSTRING(IL,1,20),'
      '      PK,'
      '      WEB=SUBSTRING(WEB,1,50),'
      '      EMAIL=SUBSTRING(EMAIL,1,50),'
      '      KATEGORI,'
      '      SUBEID,'
      '      EKLEMETARIHI'
      'FROM('
      'Select'
      '        R.ID,'
      '                               REPLACE(R.KOD,'#39'.'#39','#39' '#39') KOD,'
      '                               LEFT(R.FIRMA,50) FIRMA,'
      '                               SINIF=RSinif.ANAHTAR,'
      '                               R.MUHAKTAR,'
      '                               R.MUHKODU,'
      
        '                ISTEL     =(SELECT TOP 1 BILGI FROM REHBERBILGI ' +
        'RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI=1 and R' +
        'A.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REHBERILETISIM RI ' +
        'ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYILAN=40),'
      
        '                               CEP=(SELECT TOP 1 BILGI FROM REHB' +
        'ERBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI' +
        '=1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REHBERILET' +
        'ISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYI' +
        'LAN=42),'
      
        '                               FAX=(SELECT TOP 1 BILGI FROM dbo.' +
        'REHBERBILGI RB(NOLOCK) INNER JOIN dbo.REHBERAYAR RA (NOLOCK) ON ' +
        'RA.YERI=1 AND RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REH' +
        'BERILETISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.' +
        'VARSAYILAN=43),'
      
        '                               --VNO=(SELECT TOP 1 BILGI FROM db' +
        'o.REHBERBILGI RB INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI=2 ' +
        'AND RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REHBERILETISI' +
        'M RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYILAN' +
        '=22),'
      
        '                               --VD=(SELECT TOP 1 BILGI FROM dbo' +
        '.REHBERBILGI RB INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI=2 A' +
        'ND RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REHBERILETISIM' +
        ' RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYILAN=' +
        '20),'
      
        '                               VNO=(SELECT TOP 1 BILGI FROM REHB' +
        'ERBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI' +
        '=2 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID ' +
        'AND RA.VARSAYILAN=22),'
      
        #9#9#9#9#9#9#9'   VD=(SELECT TOP 1 BILGI FROM REHBERBILGI RB (nolock) IN' +
        'NER JOIN REHBERAYAR RA (nolock) ON RA.YERI=2 and RA.SIRA=RB.SIRA' +
        ' AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RA.VARSAYILAN=20),'
      ''
      ''
      
        '                               VDNO=(SELECT TOP 1 VD.VDKODU FROM' +
        ' dbo.REHBERBILGI RB INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI' +
        '=2 AND RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN  dbo.VDLIS' +
        'TE VD ON VD.VD=RB.BILGI INNER JOIN REHBERILETISIM RI ON RB.YER_I' +
        'D=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYILAN=20),'
      
        '                               ADRES=(SELECT TOP 1 left(BILGI,50' +
        ') FROM REHBERBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock)' +
        ' ON RA.YERI=1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN' +
        ' REHBERILETISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND' +
        ' RA.VARSAYILAN=2),'
      
        '                               ILCE=(SELECT TOP 1 BILGI FROM REH' +
        'BERBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YER' +
        'I=1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI  INNER JOIN REHBERIL' +
        'ETISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSA' +
        'YILAN=6),'
      
        '                               IL=(SELECT TOP 1 BILGI FROM REHBE' +
        'RBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI=' +
        '1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI  INNER JOIN REHBERILET' +
        'ISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYI' +
        'LAN=8),'
      
        '                               PK=(SELECT TOP 1 BILGI FROM REHBE' +
        'RBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI=' +
        '1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI  INNER JOIN REHBERILET' +
        'ISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYI' +
        'LAN=4),'
      
        '                               WEB=(SELECT TOP 1 BILGI FROM REHB' +
        'ERBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA.YERI' +
        '=1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REHBERILET' +
        'ISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VARSAYI' +
        'LAN=48),'
      
        '                               EMAIL   =(SELECT TOP 1 BILGI FROM' +
        ' REHBERBILGI RB (nolock) INNER JOIN REHBERAYAR RA (nolock) ON RA' +
        '.YERI=1 and RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI INNER JOIN REHBE' +
        'RILETISIM RI ON RB.YER_ID=RI.ID WHERE RI.REHBERID=R.ID AND RA.VA' +
        'RSAYILAN=46),'
      
        '                    KATEGORI=case when R.GRUP=335 then RGorev.AN' +
        'AHTAR  else RKategori.ANAHTAR  end,'
      '                               R.SUBEID,R.EKLEMETARIHI'
      ''
      '   from'
      '                               REHBER R'
      
        '                                  left outer join GENINI RSinif ' +
        'on RSinif.DEGER=R.SINIF and RSinif.BOLUM=-2203 and RSinif.DIL='#39'-' +
        '1'#39
      
        '                                  left outer join GENINI RKatego' +
        'ri on RKategori.DEGER=R.SINIF and RKategori.BOLUM=-2204 and RKat' +
        'egori.DIL='#39'-1'#39
      
        '                                  left outer join GENINI RGorev ' +
        'on RGorev.BOLUM=-2205 and RGorev.DEGER=R.KATEGORI and RGorev.DIL' +
        '='#39'-1'#39
      
        '                                  left outer join REHBER R2 on R' +
        '2.ID=R.TEMSILCI'
      ''
      '  WHERE'
      
        '                               (R.KOD LIKE '#39'120%'#39' OR R.KOD LIKE ' +
        #39'320%'#39' OR R.KOD LIKE '#39'329%'#39' OR R.KOD LIKE '#39'331%'#39' )'
      ''
      '                               and   isnull(R.MUHAKTAR,0)=0 and'
      ''
      
        '                               (EXISTS (SELECT FB.REHBERID FROM ' +
        'FATBASLIK FB WHERE R.ID=FB.REHBERID AND FB.EKLEMETARIHI BETWEEN ' +
        '@BASLANGIC AND @BITIS )'
      '                               OR'
      
        '                               EXISTS (SELECT K.REHBERID FROM KA' +
        'SA K WHERE R.ID=K.REHBERID AND K.EKLEMETARIHI BETWEEN @BASLANGIC' +
        ' AND @BITIS )'
      '                               OR'
      
        '                               EXISTS (SELECT C.REHBERID FROM CE' +
        'KLER C WHERE R.ID=C.REHBERID AND C.EKLEMETARIHI BETWEEN @BASLANG' +
        'IC AND @BITIS)'
      '                               OR'
      
        '                               EXISTS (SELECT CH.REHBERID FROM C' +
        'EKHAREKET CH WHERE R.ID=CH.REHBERID AND CH.EKLEMETARIHI BETWEEN ' +
        '@BASLANGIC AND @BITIS )'
      '                               )'
      ') AS X'
      'order by KOD'
      ''
      '')
    Left = 130
    Top = 344
  end
