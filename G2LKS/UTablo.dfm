  object qryComboMedulaSube: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'PKullaniciAdi'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'select S.ID, S.SUBE from KULLANSUBELERI KS'
      'INNER JOIN SUBELER S ON S.ID = KS.SUBE_ID '
      'WHERE KS.KULLANICIADI = :PKullaniciAdi'
      'ORDER BY S.SUBE')
    Left = 504
    Top = 320
  end
