  object TabPDKSListesi: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabPDKSListesiAfterOpen
    Parameters = <>
    SQL.Strings = (
      'SELECT'
      '  PP.ID, R.ID AS REHBERID, R.R, PP.MUHAKTAR,'
      '  KARTNO=('
      #9'SELECT RB.BILGI '
      #9'FROM dbo.REHBERBILGI RB '
      #9'WHERE RB.YER_ID=R.ID AND RB.YERI=11 AND RB.SIRA=10'
      #9'),'
      '  R.FIRMA, PV.GUNADI, PP.GIRIS, PP.CIKIS, PP.SUBEID, PP.DURUM,'
      '  MUHKODU=(SELECT MUHKODU  FROM REHBER R1 WHERE R1.ID=R.SUBEID),'
      
        '  ISEGIRISTARIHI=(SELECT TOP 1 TARIH FROM dbo.PERS_HAREKET WHERE' +
        ' REHBERID=R.ID AND TUR=1 ORDER BY EKLEMETARIHI DESC),'
      
        '  ISDENAYRILMATARIHI=(SELECT TOP 1 TARIH FROM dbo.PERS_HAREKET W' +
        'HERE REHBERID=R.ID AND TUR=99 ORDER BY EKLEMETARIHI DESC),'
      
        '  TCNO=ISNULL((SELECT TOP 1 ISNULL(BILGI,'#39#39') FROM dbo.REHBERBILG' +
        'I WHERE YERI=3 AND SIRA=22 AND YER_ID=R.ID),'#39#39'),'
      
        '  VARGIRISCIKIS=(CONVERT(varchar,PV.GIRIS,108) +'#39' / '#39'+CONVERT(va' +
        'rchar,PV.CIKIS,108)), '
      
        '  GIRFARK=ISNULL(dbo.fn_GIRFARK(CONVERT(varchar,PV.GIRIS,108),PP' +
        '.GIRIS),'#39'00:00'#39'),'
      
        '  CALSURE=ISNULL(dbo.fn_SaatOlarak(DATEDIFF(mi,PP.GIRIS,PP.CIKIS' +
        ')),'#39'00:00'#39'),'
      
        '  CALFARK= CASE WHEN CHARINDEX('#39'*'#39',dbo.fn_SaatOlarak(DATEDIFF(mi' +
        ',PP.GIRIS,PP.CIKIS)))=0 THEN '
      
        '  dbo.fn_CALFARK(convert(varchar,(PV.CIKIS-PV.GIRIS),108),dbo.fn' +
        '_SaatOlarak(DATEDIFF(mi,PP.GIRIS,PP.CIKIS))) ELSE '#39'00:00'#39' END,'
      
        '  CIKFARK=ISNULL(dbo.fn_CIKFARK(convert(VARCHAR,PV.GIRIS,108),CO' +
        'NVERT(VARCHAR,(PV.CIKIS-PV.GIRIS),108),PP.GIRIS,PP.CIKIS),'#39'00:00' +
        #39')'
      'FROM PERS_PDKS PP'
      #9'LEFT OUTER JOIN REHBER R ON R.ID=PP.REHBERID'
      #9'LEFT OUTER JOIN PERS_VARDIYATANIM PV ON'
      #9#9'PV.REHBERID = CASE '
      
        #9#9#9#9#9'WHEN EXISTS(SELECT TOP 1 ISNULL(REHBERID,-1) FROM dbo.PERS_' +
        'VARDIYATANIM WHERE REHBERID=PP.REHBERID) THEN'
      #9#9#9#9#9#9'PP.REHBERID '
      #9#9#9#9#9'ELSE -1 '
      #9#9#9#9#9'END AND PV.GUN=DATEPART(WEEKDAY,PP.GIRIS) '
      'WHERE AY = 0 and PP.REHBERID <> 0')
    Left = 216
    Top = 248
  end
  object DtsPDKSListesi: TDataSource
    DataSet = TabPDKSListesi
    Left = 216
    Top = 312
  end
  object TabCekler: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'SELECT'
      #9'C.ID,C.MUHAKTAR,C.SUBEID,'
      #9'ISLEMTIPI      = CASE WHEN C.TUR=23 THEN '#39'-1'#39' ELSE '#39'1'#39' END,'
      #9'BELGETIPI'#9'   = '#39'1'#39','
      #9'CEKHAREKETTIPI = CASE WHEN G.DEGER=1 THEN '#39'-1'#39
      #9#9#9#9#9#9'  WHEN G.DEGER=4 THEN '#39'00'#39
      #9#9#9#9#9#9'  WHEN G.DEGER=5 THEN '#39'01'#39
      #9#9#9#9#9#9'  WHEN G.DEGER=8 THEN '#39'05'#39
      #9#9#9#9#9#9'  WHEN G.DEGER=12 THEN '#39'04'#39
      #9#9#9#9#9#9'  WHEN G.DEGER=6 THEN '#39'02'#39
      #9#9#9#9#9#9'  WHEN G.DEGER=11 THEN '#39'08'#39
      #9#9#9#9#9#9'  ELSE '#39'-1'#39' END,'
      
        #9'HESAPKODU'#9'   = CASE WHEN C.TUR=23 THEN R.KOD   ELSE HP.HESAPKOD' +
        'U END,'
      
        #9'HESAPADI'#9'   = CASE WHEN C.TUR=23 THEN R.FIRMA ELSE HP.HESAPADI ' +
        'END,'
      #9'BELGETARIHI'#9'   = C.TARIH,'
      #9'BELGENO'#9#9'   = MAKBUZNO,'
      #9'ACIKLAMA'#9'   = C.ACIKLAMA,'
      #9'BANKAKODU'#9'   = '#39#39','
      #9'SUBEKODU'#9'   = BS.SUBEKODU,'
      #9'SUBEADI'#9#9'   = BS.SUBEADI,'
      #9'CEKHESAPNO'#9'   = C.HESAPNO,'
      #9'CEKNO'#9#9'   = C.SERINO,'
      #9'TUTAR'#9#9'   = C.TUTAR,'
      
        #9'KARSIHESAPKODU = CASE WHEN C.TUR=23 THEN HP.HESAPKODU  ELSE R.K' +
        'OD END,'
      
        #9'KARSIHESAPADI  = CASE WHEN C.TUR=23 THEN HP.HESAPADI   ELSE R.F' +
        'IRMA END,'
      #9'C.EKLEMETARIHI'
      'FROM'
      #9'CEKLER C INNER JOIN REHBER R ON C.REHBERID=R.ID'
      #9#9'     LEFT JOIN  HESAPPLANI HP ON C.KOD=HP.HESAPKODU'
      #9#9'     INNER JOIN BANKASUBELER BS ON C.BANKASUBELERID=BS.ID'
      #9#9#9' LEFT JOIN  CEKHAREKET CK ON C.ID=CK.CEKSENETLERID'
      
        #9#9#9' LEFT JOIN GENINI G ON G.DEGER=CK.ISLEM AND G.BOLUM='#39'-2601'#39' A' +
        'ND DIL='#39'-1'#39
      'WHERE')
    Left = 304
    Top = 192
  end
  object DtsCekler: TDataSource
    DataSet = TabCekler
    Left = 304
    Top = 248
  end
