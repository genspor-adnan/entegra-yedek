  object TabFaturaListesi: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabFaturaListesiAfterOpen
    AfterScroll = TabFaturaListesiAfterScroll
    Parameters = <>
    SQL.Strings = (
      'SELECT distinct FB.ID,FB.TUR,'
      'R.KOD,'
      'R.FIRMA ,'
      'FB.BASLIK,'
      'FB.FATURANO,'
      'FB.FATURATARIH,'
      'KDVHARICTUTARI=ROUND(FB.FATURA_MATRAHI,2),'
      'KDV_TUTARI = ROUND(FB.KDV_TUTARI,2),'
      'KDVDAHILTUTARI= ROUND(FB.FATURA_TUTARI,2),'
      'MUHAKTAR = ISNULL(FB.MUHAKTAR,0) ,'
      ''
      'FB.AKTARMATARIHI,'
      'FB.SUBEID'
      #9#9'    '#9#9'    '
      #9'FROM'
      #9#9'FATBASLIK FB INNER JOIN FATURA F on FB.ID=F.FATBASID'
      #9#9'inner join REHBER R on FB.REHBERID=R.ID')
    Left = 42
    Top = 192
  end
  object DtsFaturaListesi: TDataSource
    DataSet = TabFaturaListesi
    Left = 130
    Top = 192
  end
  object TabFaturaDetay: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterScroll = TabFaturaDetayAfterScroll
    Parameters = <
      item
        Name = 'Par'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'select * from ('
      ''
      'Select'
      'F.*, MASRAFKOD=MG.KOD,MASRAFAD=MG.AD,'
      
        'AD = CASE WHEN F.TUR IN( 1,11) THEN (SELECT STOKADI FROM STOKLAR' +
        ' WHERE ID = F.URUNID ) ELSE (SELECT AD FROM MASRAFGELIR WHERE ID' +
        ' = F.URUNID) END,'
      
        'KOD = CASE WHEN F.TUR IN (1,11) THEN (SELECT KOD FROM STOKLAR WH' +
        'ERE ID = F.URUNID ) ELSE (SELECT KOD FROM MASRAFGELIR WHERE ID= ' +
        'F.URUNID ) END,'
      
        'PROJEKODU=(Select P.PROJEKODU from PROJELER P Where P.ID=F.PROJE' +
        'ID),'#39' '#39' as TESLIMTARIHI'
      'from'
      'FATURA F left outer join'
      'MASRAFGELIR MG on'
      'F.MASRAFID=MG.ID'
      'Where'
      'F.FATBASID = :Par'
      ')as asd'
      'order by ID')
    Left = 42
    Top = 240
  end
  object DtsFaturaDetay: TDataSource
    DataSet = TabFaturaDetay
    Left = 130
    Top = 240
  end
