  object TabPersonelListesi: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabPersonelListesiAfterOpen
    Parameters = <
      item
        Name = 'Dil'
        DataType = ftWideString
        Size = 2
        Value = Null
      end>
    SQL.Strings = (
      'Declare @Dil integer'
      'Set @Dil=:Dil'
      '    Select R.ID,R.KOD,R.FIRMA,R.MUHAKTAR,'
      
        #9'ISBASLANGIC=(SELECT TOP 1 PH.TARIH FROM dbo.PERS_HAREKET PH WHE' +
        'RE R.ID=PH.REHBERID AND TUR=1),'
      
        #9'SSKBASLANGIC=(SELECT TOP 1 PH.TARIH FROM dbo.PERS_HAREKET PH WH' +
        'ERE R.ID=PH.REHBERID AND TUR=5),'
      
        #9'MESLEKKODU=(SELECT TOP 1 PH.MESLEKID FROM dbo.PERS_HAREKET PH W' +
        'HERE R.ID=PH.REHBERID),'
      
        #9'SUBEID=100000,--(SELECT MUHKODU  FROM REHBER R1 WHERE R1.ID=R.S' +
        'UBEID),'
      
        '    --ISNULL((SELECT TOP 1 SUBEID FROM dbo.PERS_HAREKET P WHERE ' +
        'P.REHBERID=R.ID ORDER BY P.TARIH DESC),R.SUBEID),'
      #9'R.EKLEMETARIHI,'
      
        #9'KARTNO=(SELECT RB.BILGI FROM dbo.REHBERBILGI RB WHERE RB.SIRA=1' +
        '0 AND RB.YERI=11 AND RB.YER_ID=R.ID),'
      
        '    ADRES=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) IN' +
        'NER JOIN dbo.REHBERAYAR RA (NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.' +
        'SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RA.VARSAYILAN=' +
        '2), '
      
        #9'TCKIMLIKNO=(SELECT  TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK)' +
        ' INNER JOIN dbo.REHBERAYAR RA (NOLOCK) ON RA.YERI=3 AND RA.SIRA=' +
        'RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=22)' +
        ','
      
        #9'AILESIRANO=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) ' +
        'INNER JOIN dbo.REHBERAYAR RA (NOLOCK) ON RA.YERI=3 AND RA.SIRA=R' +
        'B.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=39),'
      
        #9'CILTNO=(SELECT  TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INN' +
        'ER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=RB.SI' +
        'RA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=38),'
      
        '    CINSIYET=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK)' +
        ' INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=R' +
        'B.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=16),'
      
        '    CEPTELEFON=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOC' +
        'K) INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA' +
        '=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=6)' +
        ','
      
        '    DOGUMYERI=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK' +
        ') INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=' +
        'RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=18)' +
        ','
      
        '    DOGUMTARIHI=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLO' +
        'CK) INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIR' +
        'A=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=2' +
        '0),'
      
        '    ANAADI=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) I' +
        'NNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=RB.' +
        'SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=34),'
      
        #9'BABAADI=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INN' +
        'ER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=RB.SI' +
        'RA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=37),'
      
        '    NUFUSIL=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) ' +
        'INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=RB' +
        '.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=35),'
      
        '    NUFUSILCE=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK' +
        ') INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA=' +
        'RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=36)' +
        ','
      
        '    BIREYSIRANO=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLO' +
        'CK) INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIR' +
        'A=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=4' +
        '0),'
      
        '    ISTEL1=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) I' +
        'NNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.' +
        'SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=2),'
      
        '    ISTEL2=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) I' +
        'NNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.' +
        'SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=4),'
      
        #9'FAX=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INNER J' +
        'OIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.SIRA A' +
        'ND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=12),'
      
        #9'EPOSTA=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INNE' +
        'R JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.SIR' +
        'A AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=16),'
      
        '    WEB=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INNE' +
        'R JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.SIR' +
        'A AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=22),'
      
        #9'POSTAKOD=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) IN' +
        'NER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.S' +
        'IRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=52),'
      
        #9'ILCE=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INNER ' +
        'JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.SIRA ' +
        'AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=54),'
      
        #9'IL=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOCK) INNER JO' +
        'IN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=1 AND RA.SIRA=RB.SIRA AN' +
        'D RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=56),'
      
        '      KANGRUBU=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB(NOLOC' +
        'K) INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND RA.SIRA' +
        '=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.SIRA=42' +
        '),'
      
        '    --ISEGIRISTARIHI=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB' +
        '(NOLOCK) INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND R' +
        'A.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RA.V' +
        'ARSAYILAN=89),'
      
        '    NETMAAS=0,--(SELECT TOP 1 TUTAR FROM dbo.PLANMAAS PM(NOLOCK)' +
        ' INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=5 AND RA.SIRA=P' +
        'M.SIRA WHERE PM.REHBERID=R.ID AND RA.VARSAYILAN=36 AND PM.SIRA=1' +
        '0),'
      
        '    ISTENCIKISTARIHI=(SELECT TOP 1 BILGI FROM dbo.REHBERBILGI RB' +
        '(NOLOCK) INNER JOIN dbo.REHBERAYAR RA(NOLOCK) ON RA.YERI=3 AND R' +
        'A.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.ID AND RB.S' +
        'IRA=32) '
      '   from REHBER R '
      
        '   left outer join GENINI RSinif on RSinif.DEGER=R.SINIF and RSi' +
        'nif.BOLUM=-2203 and RSinif.DIL=@Dil '
      
        '   left outer join GENINI RKategori on RKategori.DEGER=R.SINIF a' +
        'nd RKategori.BOLUM=-2204 and RKategori.DIL=@Dil '
      
        '   left outer join GENINI RGorev on RGorev.BOLUM=-2205 and RGore' +
        'v.DEGER=R.KATEGORI and RGorev.DIL=@Dil '
      '   left outer join REHBER R2 on R2.ID=R.TEMSILCI'
      '   left outer join REHBERPERSONEL RP on R.ID = RP.REHBERID'
      '   left outer join REHBERILETISIM RI on R.ID = RI.REHBERID'
      '')
    Left = 216
    Top = 192
  end
