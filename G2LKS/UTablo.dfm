  object TabStoklar: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabStoklarAfterOpen
    Parameters = <
      item
        Name = 'Dil'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'Declare @Dil integer'
      'Set @Dil=:Dil'
      ''
      'SELECT'
      
        ' S.ID, S.KOD, S.STOKADI, S.TIPI,STipi.ANAHTAR AS STOKTIPI,S.MUHK' +
        'ODU,S.MARKA,SMarka.ANAHTAR AS STOKMARKA, S.MODEL,SModel.ANAHTAR ' +
        'AS STOKMODEL, S.GRUBU, S.OZELLIK,S.ICERIK, S.OZELKOD,S.SUBEID, '
      
        ' S.ID AS STOKID, S.ANABIRIM,SBirim.ANAHTAR AS STOKBIRIM, S.BIRIM' +
        '2, S.BIRIM2MIKTAR, S.MINSTOK, S.KDV, S.DURUM, '
      ' S.IZLEME, S.NOTLAR,S.EKLEMETARIHI,S.MUHAKTAR ,S.SUBEID'
      'FROM         '
      ' STOKLAR S '
      
        ' LEFT OUTER JOIN GENINI SModel ON SModel.DEGER = S.MODEL AND SMo' +
        'del.BOLUM=convert(int,'#39'-2701'#39'+convert(varchar(10),S.MARKA))  and' +
        ' SModel.DIL='#9'@Dil'#9#9#9#9#9' '
      
        ' LEFT OUTER JOIN GENINI SMarka ON SMarka.DEGER = S.MARKA AND SMa' +
        'rka.BOLUM=-2701 and SMarka.DIL=@Dil'#9
      
        ' LEFT OUTER JOIN GENINI SBirim ON SBirim.DEGER = S.ANABIRIM AND ' +
        'SBirim.BOLUM=-2702 and SBirim.DIL=@Dil'#9
      
        ' LEFT OUTER JOIN GENINI STipi ON STipi.DEGER = S.TIPI AND STipi.' +
        'BOLUM=-2703 and STipi.DIL='#9'@Dil'#9)
    Left = 42
    Top = 344
  end
  object DtsTabStoklar: TDataSource
    DataSet = TabStoklar
    Left = 42
    Top = 400
  end
