  object TabHesapPlani: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'MUHAKTAR'
        DataType = ftWideString
        Size = 1
        Value = Null
      end>
    SQL.Strings = (
      'DECLARE'
      '       @MUHAKTAR BIT'
      '       SET @MUHAKTAR=:MUHAKTAR'
      '  SELECT'
      
        '       ROW_NUMBER() OVER(ORDER BY A.HESAPKODU) SEC,TABLOADI,ID,H' +
        'ESAPKODU=SUBSTRING(HESAPKODU,1,30),HESAPADI=(SUBSTRING(HESAPADI,' +
        '1,50)),PLANTURU'
      'FROM'
      '       ('
      
        '             SELECT TABLOADI,ID,REPLACE(HESAPKODU,'#39'.'#39','#39' '#39') AS HE' +
        'SAPKODU,HESAPADI,PLANTURU FROM ('
      
        '             SELECT '#39'HESAPPLANI'#39' AS TABLOADI,ID,HESAPKODU,HESAPA' +
        'DI,PLANTURU FROM HESAPPLANI WHERE ISNULL(MUHAKTAR,0)=@MUHAKTAR'
      '             UNION'
      
        '             SELECT '#39'KASALAR'#39' AS TABLOADI,ID,KASAKODU AS HESAPKO' +
        'DU,KASAADI AS HESAPADI,PLANTURU=3 FROM KASALAR WHERE ISNULL(MUHA' +
        'KTAR,0)=@MUHAKTAR'
      '             UNION'
      
        '             SELECT '#39'BANKAHESAPLAR'#39' AS TABLOADI,ID,HESAPKODU,HES' +
        'APADI,PLANTURU=3 FROM BANKAHESAPLAR WHERE ISNULL(MUHAKTAR,0)=@MU' +
        'HAKTAR'
      '             UNION'
      
        '             SELECT '#39'POS'#39' AS TABLOADI,ID,KODU AS HESAPKODU,ADI A' +
        'S HESAPADI,PLANTURU=3 FROM POS WHERE ISNULL(MUHAKTAR,0)=@MUHAKTA' +
        'R'
      '             UNION'
      
        '             SELECT '#39'KREDIKARTI'#39' AS TABLOADI,ID,KODU AS HESAPKOD' +
        'U,ADI AS HESAPADI,PLANTURU=3 FROM KREDIKARTI WHERE ISNULL(MUHAKT' +
        'AR,0)=@MUHAKTAR'
      '             UNION'
      
        '             SELECT '#39'KREDILER'#39' AS TABLOADI,ID,KREDIKODU AS HESAP' +
        'KODU,ADI AS HESAPADI,PLANTURU=3 FROM KREDILER WHERE ISNULL(MUHAK' +
        'TAR,0)=@MUHAKTAR'
      '             UNION'
      
        '             SELECT '#39'MASRAFGELIR'#39' AS TABLOADI,ID,KOD AS HESAPKOD' +
        'U,AD AS HESAPADI,PLANTURU=3 FROM MASRAFGELIR WHERE ISNULL(MUHAKT' +
        'AR,0)=@MUHAKTAR'
      '             ) AS X'
      '             WHERE'
      '             ISNULL(HESAPADI,'#39#39')<>'#39#39
      ''
      '       ) A ORDER BY REPLACE(A.HESAPKODU,'#39'.'#39','#39' '#39')'
      ''
      '')
    Left = 384
    Top = 304
  end
  object DtsHesapPlani: TDataSource
    DataSet = TabHesapPlani
    Left = 384
    Top = 360
  end
  object TabDokum: TADOQuery
    Connection = cnn
    Parameters = <
      item
        Name = 'PID'
        Size = -1
        Value = Null
      end>
