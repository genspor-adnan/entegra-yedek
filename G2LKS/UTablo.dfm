  object TabKullan: TADOQuery
    Connection = cnn
    Parameters = <>
    SQL.Strings = (
      'select K.ID,K.REHBERID,K.SIFRE,K.KOD,K.ROLID,K.DURUM,R.FIRMA '
      
        '                            from REHBER R inner join KULLANICI K' +
        ' on K.REHBERID=R.ID where R.DURUM=1 and K.DURUM=1 order by 1')
    Left = 160
    Top = 17
  end
  object TabTahsilatListesi: TADOQuery
    Connection = cnn
    CursorType = ctStatic
    AfterOpen = TabTahsilatListesiAfterOpen
    Parameters = <>
    SQL.Strings = (
      'SELECT * FROM ('
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      
        'ISLEMTIPI = CASE WHEN K.TUR IN (31,32,53) THEN 1 WHEN K.TUR IN (' +
        '21,51) THEN '#39'-1'#39' END,'
      'BELGETIPI = CASE WHEN K.TUR=31 THEN '#39'0'#39
      #9#9#9#9' WHEN K.TUR=32 THEN '#39'0'#39
      #9#9#9#9' WHEN K.TUR=53 THEN '#39'1'#39
      #9#9#9#9' WHEN K.TUR=51 THEN '#39'1'#39
      #9#9#9#9' WHEN K.TUR=21 THEN '#39'0'#39' END,'
      'HESAPKODU ='
      
        #9#9#9'CASE WHEN K.HESAPTURU='#39'B'#39' AND K.TUR NOT IN (21) then (select ' +
        'BH.HESAPKODU from BANKAHESAPLAR BH where BH.ID=K.HESAPID )'
      
        #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' AND K.TUR NOT IN (21) then (select KS.' +
        'KASAKODU from KASALAR KS where KS.ID=K.HESAPID )'
      #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' AND K.TUR = 21 THEN R.KOD'
      #9#9#9'end,'
      'HESAPADI='
      
        #9#9#9'CASE WHEN K.HESAPTURU='#39'B'#39' AND K.TUR NOT IN (21) THEN (SELECT ' +
        'BH.HESAPADI FROM dbo.BANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' AND K.TUR NOT IN (21) THEN (SELECT KS.' +
        'KASAADI FROM dbo.KASALAR KS WHERE KS.ID=K.HESAPID)'
      #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' AND K.TUR = 21 THEN R.FIRMA'
      #9#9#9'END,'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=CASE WHEN K.TUR IN (21,51) THEN K.ALACAK ELSE K.BORC END,'
      'KARSIHESAPKODU ='
      #9#9#9'CASE '
      
        #9#9#9#9'WHEN K.REHBERID=0 AND K.TUR NOT IN (51,53,21) then (select M' +
        '.KOD from MASRAFGELIR M where M.ID=K.MASRAFID )'
      #9#9#9#9'WHEN K.REHBERID=0 AND K.TUR IN (53,51) then C.KOD'
      
        #9#9#9#9'WHEN K.TUR=32 AND ISNULL(K.MASRAFID,0)<>0 THEN (select M.KOD' +
        ' from MASRAFGELIR M where M.ID=K.MASRAFID )'
      
        #9#9#9#9'WHEN K.TUR=21 THEN (select KS.KASAKODU from KASALAR KS where' +
        ' KS.ID=K.HESAPID )'
      #9#9#9'ELSE (select KOD from REHBER R where R.ID=K.REHBERID ) end,'
      #9#9#9
      'KARSIHESAPADI ='
      
        #9#9#9'CASE WHEN K.REHBERID=0 AND K.TUR NOT IN (53,51) then (select ' +
        'M.AD from MASRAFGELIR M where M.ID=K.MASRAFID )'
      #9#9#9#9' WHEN K.REHBERID=0 AND K.TUR IN (53,51) then BH.HESAPADI'
      
        #9#9#9#9' WHEN K.TUR=32 AND ISNULL(K.MASRAFID,0)<>0 THEN (select M.AD' +
        ' from MASRAFGELIR M where M.ID=K.MASRAFID )'
      
        #9#9#9#9' WHEN K.TUR=21 THEN (select KS.KASAADI from KASALAR KS where' +
        ' KS.ID=K.HESAPID )'
      
        #9#9#9#9'ELSE (select FIRMA from REHBER R where R.ID=K.REHBERID ) end' +
        ','
      ''
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      'LEFT JOIN CEKLER C ON K.CEKSENETID=C.ID'
      'LEFT JOIN BANKAHESAPLAR BH ON K.HESAPID=BH.ID'
      'LEFT JOIN REHBER R ON K.REHBERID=R.ID'
      'WHERE'
      'K.TUR IN (21,31,32,51,53) AND ISNULL(K.R,0)=0'
      'UNION ALL'
      ''
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = 1,'
      'BELGETIPI = 0,'
      
        'HESAPKODU = CASE WHEN K.HESAPTURU='#39'B'#39' then (select BH.HESAPKODU ' +
        'from BANKAHESAPLAR BH where BH.ID=K.HESAPID )'
      
        #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' then (select KS.KASAKODU from KASALAR ' +
        'KS where KS.ID=K.HESAPID )'
      #9#9#9'end,'
      'HESAPADI='
      
        #9#9#9'CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAPADI FROM dbo.B' +
        'ANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAADI FROM dbo.KASALAR' +
        ' KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      ''
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.BORC,'
      
        'KARSIHESAPKODU =(SELECT KODU FROM KREDIKARTI KK,KASA K1 WHERE KK' +
        '.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      #9
      
        'KARSIHESAPADI = (SELECT ADI FROM KREDIKARTI KK,KASA K1 WHERE KK.' +
        'ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      ''
      'WHERE'
      'K.TUR IN (57) AND ISNULL(R,0)=0 AND K.HESAPTURU IN ('#39'B'#39','#39'K'#39')'
      ''
      'UNION ALL'
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = '#39'-1'#39','
      'BELGETIPI = 0,'
      
        'HESAPKODU = CASE WHEN K.HESAPTURU='#39'B'#39' then (select BH.HESAPKODU ' +
        'from BANKAHESAPLAR BH where BH.ID=K.HESAPID )'
      
        #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' then (select KS.KASAKODU from KASALAR ' +
        'KS where KS.ID=K.HESAPID )'
      #9#9#9'end,'
      'HESAPADI='
      
        #9#9#9'CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAPADI FROM dbo.B' +
        'ANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAADI FROM dbo.KASALAR' +
        ' KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.BORC,'
      
        'KARSIHESAPKODU =(SELECT KASAKODU FROM KASALAR KK,KASA K1 WHERE K' +
        'K.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      #9
      
        'KARSIHESAPADI = (SELECT KASAADI FROM KASALAR KK,KASA K1 WHERE KK' +
        '.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      ''
      'WHERE'
      'K.TUR IN (42) AND ISNULL(R,0)=0 AND K.HESAPTURU='#39'B'#39
      ''
      'UNION ALL '
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = 1,'
      'BELGETIPI = 0,'
      
        'HESAPKODU = (SELECT KASAKODU FROM KASALAR KK,KASA K1 WHERE KK.ID' +
        '=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      
        'HESAPADI  = (SELECT KASAADI FROM KASALAR KK,KASA K1 WHERE KK.ID=' +
        'K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      ''
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.ALACAK,'
      
        'KARSIHESAPKODU = CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAP' +
        'KODU FROM dbo.BANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAKODU FROM dbo.KASALA' +
        'R KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      #9
      
        'KARSIHESAPADI  = CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAP' +
        'ADI FROM dbo.BANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAADI FROM dbo.KASALAR' +
        ' KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      ''
      'WHERE'
      'K.TUR IN (46) AND ISNULL(R,0)=0 AND KUR='#39'TL'#39
      ''
      'UNION ALL '
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = 1,'
      'BELGETIPI = 0,'
      
        'HESAPKODU =(SELECT KK.HESAPKODU FROM BANKAHESAPLAR KK,KASA K1 WH' +
        'ERE KK.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),  '
      ''
      
        'HESAPADI  =(SELECT KK.HESAPADI FROM BANKAHESAPLAR KK,KASA K1 WHE' +
        'RE KK.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),  '
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.ALACAK,'
      
        'KARSIHESAPKODU =CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAPK' +
        'ODU FROM dbo.BANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAKODU FROM dbo.KASALA' +
        'R KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      
        'KARSIHESAPADI  = CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAP' +
        'ADI FROM dbo.BANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAADI FROM dbo.KASALAR' +
        ' KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      ''
      'WHERE'
      'K.TUR IN (48) AND ISNULL(R,0)=0 AND KUR='#39'TL'#39
      ''
      'UNION ALL'
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = 1,'
      'BELGETIPI = 0,'
      
        'HESAPKODU = (SELECT KASAKODU FROM KASALAR KK,KASA K1 WHERE KK.ID' +
        '=K1.HESAPID AND K1.ID=K.ID), '
      
        'HESAPADI=  (SELECT KASAADI FROM KASALAR KK,KASA K1 WHERE KK.ID=K' +
        '1.HESAPID AND K1.ID=K.ID),'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.BORC,'
      
        'KARSIHESAPKODU =(SELECT KK.HESAPKODU FROM BANKAHESAPLAR KK,KASA ' +
        'K1 WHERE KK.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      #9
      
        'KARSIHESAPADI = (SELECT KK.HESAPADI FROM BANKAHESAPLAR KK,KASA K' +
        '1 WHERE KK.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      ''
      'WHERE'
      'K.TUR IN (41) AND ISNULL(R,0)=0 AND K.HESAPTURU='#39'K'#39
      ''
      'UNION ALL'
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = 1,'
      'BELGETIPI = 0,'
      
        'HESAPKODU = (SELECT KK.HESAPKODU FROM BANKAHESAPLAR KK,KASA K1 W' +
        'HERE KK.ID=K1.HESAPID AND K1.ID=K.ID),'
      
        'HESAPADI  = (SELECT KK.HESAPADI  FROM BANKAHESAPLAR KK,KASA K1 W' +
        'HERE KK.ID=K1.HESAPID AND K1.ID=K.ID),'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.BORC,'
      
        'KARSIHESAPKODU =(SELECT KK.HESAPKODU FROM BANKAHESAPLAR KK,KASA ' +
        'K1 WHERE KK.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      #9
      
        'KARSIHESAPADI = (SELECT KK.HESAPADI FROM BANKAHESAPLAR KK,KASA K' +
        '1 WHERE KK.ID=K1.HESAPID AND K1.GERIDONUSID=K.ID),'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      ''
      'WHERE'
      'K.TUR IN (43) AND ISNULL(R,0)=0 AND K.HESAPTURU='#39'B'#39
      'AND ISNULL(BORC,0)>0'
      ''
      'UNION ALL'
      ''
      
        'SELECT ID,MUHAKTAR,SUBEID,ISLEMTIPI,BELGETIPI,HESAPKODU,HESAPADI' +
        ',BELGETARIHI,BELGENO,ACIKLAMA,TUTAR,KARSIHESAPKODU,KARSIHESAPADI' +
        ',EKLEMETARIHI FROM ('
      'SELECT'
      #9'K.ID,K.MUHAKTAR,K.SUBEID,'
      #9'ISLEMTIPI = 1,'
      #9'BELGETIPI = 0,'
      #9'HESAPKODU = P.KODU,'
      #9'HESAPADI  = P.ADI,'
      #9'BELGETARIHI=K.ISLEMTARIHI,'
      #9'K.BELGENO,'
      #9'K.ACIKLAMA,'
      #9'TUTAR=K.ALACAK,'
      #9'KARSIHESAPKODU =BK.HESAPKODU,'
      #9#9
      #9'KARSIHESAPADI = BK.HESAPADI,'
      #9'K.EKLEMETARIHI'
      'FROM'
      #9'KASA K '
      
        #9#9'INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005'#39' AND DIL' +
        '='#39'-1'#39
      
        #9#9'INNER JOIN POS P ON P.ID=(SELECT HESAPID FROM KASA K1 WHERE K.' +
        'GERIDONUSID=ID AND K.HESAPTURU IN ('#39'B'#39') AND ISNULL(MASRAFID,0)=0' +
        ')'
      #9#9'LEFT  JOIN BANKAHESAPLAR BK ON BK.ID=K.HESAPID'
      ''
      ''
      'WHERE'
      #9#9'K.TUR IN (44) AND ISNULL(K.R,0)=0 AND K.HESAPTURU IN ('#39'B'#39')'
      #9'AND ISNULL(K.ALACAK,0)>0'
      ''
      'UNION ALL'
      ''
      'SELECT'
      #9'K.ID,K.MUHAKTAR,K.SUBEID,'
      #9'ISLEMTIPI = 1,'
      #9'BELGETIPI = 0,'
      #9'HESAPKODU = P.KODU,'
      #9'HESAPADI  = P.ADI,'
      #9'BELGETARIHI=K.ISLEMTARIHI,'
      #9'K.BELGENO,'
      #9'K.ACIKLAMA,'
      #9'TUTAR=K.ALACAK,'
      #9'KARSIHESAPKODU =MG.KOD,'
      #9#9
      #9'KARSIHESAPADI = MG.AD,'
      #9'K.EKLEMETARIHI'
      'FROM'
      #9'KASA K '
      
        #9#9'INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005'#39' AND DIL' +
        '='#39'-1'#39
      
        #9#9'INNER JOIN POS P ON P.ID=(SELECT HESAPID FROM KASA K1 WHERE K.' +
        'GERIDONUSID=ID AND K.HESAPTURU IN ('#39'P'#39') AND ISNULL(MASRAFID,0)=0' +
        ')'
      #9#9'LEFT  JOIN MASRAFGELIR MG ON MG.ID=K.MASRAFID'
      ''
      'WHERE'
      #9#9'K.TUR IN (44) AND ISNULL(K.R,0)=0 AND K.HESAPTURU IN ('#39'P'#39')'
      #9'AND ISNULL(K.ALACAK,0)>0'
      ''
      #9
      'UNION ALL'
      ''
      'SELECT'
      #9'K.ID,K.MUHAKTAR,K.SUBEID,'
      #9'ISLEMTIPI = 1,'
      #9'BELGETIPI = 0,'
      #9'HESAPKODU = BK.HESAPKODU,'
      #9'HESAPADI  = BK.HESAPADI,'
      #9'BELGETARIHI=K.ISLEMTARIHI,'
      #9'K.BELGENO,'
      #9'K.ACIKLAMA,'
      #9'TUTAR=K.BORC,'
      #9'KARSIHESAPKODU =MG.KOD,'
      #9'KARSIHESAPADI = MG.AD,'
      #9'K.EKLEMETARIHI'
      'FROM'
      #9'KASA K '
      
        #9#9'INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005'#39' AND DIL' +
        '='#39'-1'#39
      #9#9'LEFT  JOIN BANKAHESAPLAR BK ON BK.ID=K.HESAPID'
      #9#9'LEFT  JOIN MASRAFGELIR MG ON MG.ID=K.MASRAFID'
      ''
      'WHERE'
      #9#9'K.TUR IN (44) AND ISNULL(K.R,0)=0 AND K.HESAPTURU IN ('#39'B'#39')'
      #9'AND ISNULL(K.BORC,0)>0'
      ''
      'UNION ALL'
      ''
      'SELECT'
      #9'K.ID,K.MUHAKTAR,K.SUBEID,'
      #9'ISLEMTIPI = 1,'
      #9'BELGETIPI = 0,'
      #9'HESAPKODU = P.KODU,'
      #9'HESAPADI  = P.ADI,'
      #9'BELGETARIHI=K.ISLEMTARIHI,'
      #9'K.BELGENO,'
      #9'K.ACIKLAMA,'
      #9'TUTAR=K.BORC,'
      #9'KARSIHESAPKODU =MG.KOD,'
      #9'KARSIHESAPADI = MG.AD,'
      #9'K.EKLEMETARIHI'
      'FROM'
      #9'KASA K '
      
        #9#9'INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005'#39' AND DIL' +
        '='#39'-1'#39
      
        #9#9'INNER JOIN POS P ON P.ID=(SELECT HESAPID FROM KASA K1 WHERE K.' +
        'GERIDONUSID=ID AND K.HESAPTURU IN ('#39'P'#39') AND ISNULL(MASRAFID,0)=0' +
        ')'
      #9#9'LEFT  JOIN MASRAFGELIR MG ON MG.ID=K.MASRAFID'
      ''
      'WHERE'
      #9#9'K.TUR IN (44) AND ISNULL(K.R,0)=0 AND K.HESAPTURU IN ('#39'P'#39')'
      #9'AND ISNULL(K.BORC,0)>0 AND ISNULL(MASRAFID,0)<>0'
      ') AS X'
      ''
      'UNION ALL'
      ''
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = '#39'-1'#39','
      'BELGETIPI = 0,'
      
        'HESAPKODU = CASE WHEN K.TUR=22 AND K.REHBERID=0  THEN (Select M.' +
        'KOD from MASRAFGELIR M where M.ID=K.MASRAFID) ELSE R.KOD END,'
      
        'HESAPADI  = CASE WHEN K.TUR=22 AND K.REHBERID=0  THEN (Select M.' +
        'AD from MASRAFGELIR M where M.ID=K.MASRAFID) ELSE R.FIRMA END,'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.ALACAK,'
      
        'KARSIHESAPKODU = CASE WHEN K.HESAPTURU='#39'B'#39' then (select BH.HESAP' +
        'KODU from BANKAHESAPLAR BH where BH.ID=K.HESAPID )'
      
        #9#9#9#9' WHEN K.HESAPTURU='#39'K'#39' then (select KS.KASAKODU from KASALAR ' +
        'KS where KS.ID=K.HESAPID )'
      #9#9#9'end,'
      #9
      
        'KARSIHESAPADI'#9'= CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAPA' +
        'DI FROM dbo.BANKAHESAPLAR BH WHERE BH.ID=K.HESAPID )'
      
        #9#9#9'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAADI FROM dbo.KASALAR' +
        ' KS WHERE KS.ID=K.HESAPID)'
      #9#9#9'END,'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      #9#9'LEFT JOIN REHBER R ON K.REHBERID=R.ID'
      ''
      'WHERE'
      'K.TUR IN (22) AND ISNULL(K.R,0)=0 AND K.HESAPTURU='#39'B'#39
      ''
      'UNION ALL'
      ''
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = '#39'-1'#39','
      'BELGETIPI = 0,'
      'HESAPKODU = R.KOD,'
      'HESAPADI  = R.FIRMA,'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.ALACAK,'
      
        'KARSIHESAPKODU = CASE WHEN K.HESAPTURU='#39'P'#39' then (select BH.KODU ' +
        'from POS BH where BH.ID=K.HESAPID )'
      #9#9#9'end,'
      #9
      
        'KARSIHESAPADI'#9'= CASE WHEN K.HESAPTURU='#39'P'#39' THEN (SELECT BH.ADI FR' +
        'OM POS BH WHERE BH.ID=K.HESAPID )'
      #9#9#9'END,'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      #9#9'LEFT JOIN REHBER R ON K.REHBERID=R.ID'
      ''
      'WHERE'
      'K.TUR IN (25) AND ISNULL(K.R,0)=0 AND K.HESAPTURU='#39'P'#39
      'UNION ALL'
      'SELECT'
      'K.ID,K.MUHAKTAR,K.SUBEID,'
      'ISLEMTIPI = 1,'
      'BELGETIPI = 0,'
      'HESAPKODU ='
      
        'CASE WHEN K.HESAPTURU='#39'B'#39' then (select BH.HESAPKODU from BANKAHE' +
        'SAPLAR BH where BH.ID=K.HESAPID )'
      
        'WHEN K.HESAPTURU='#39'K'#39' then (select KS.KASAKODU from KASALAR KS wh' +
        'ere KS.ID=K.HESAPID )'
      'end,'
      'HESAPADI='
      
        'CASE WHEN K.HESAPTURU='#39'B'#39' THEN (SELECT BH.HESAPADI FROM dbo.BANK' +
        'AHESAPLAR BH WHERE BH.ID=K.HESAPID)'
      
        'WHEN K.HESAPTURU='#39'K'#39' THEN (SELECT KS.KASAADI FROM dbo.KASALAR KS' +
        ' WHERE KS.ID=K.HESAPID)'
      'END,'
      'BELGETARIHI=K.ISLEMTARIHI,'
      'K.BELGENO,'
      'K.ACIKLAMA,'
      'TUTAR=K.BORC,'
      'KARSIHESAPKODU ='
      
        'CASE WHEN K.REHBERID=0 AND K.TUR=58 then (select M.KOD from MASR' +
        'AFGELIR M where M.ID=K.MASRAFID ) ELSE KR.KREDIKODU end,'
      'KARSIHESAPADI ='
      
        'CASE WHEN  K.REHBERID=0 AND K.TUR=58 then (select M.AD from MASR' +
        'AFGELIR M where M.ID=K.MASRAFID ) ELSE KR.ADI end,'
      'K.EKLEMETARIHI'
      'FROM'
      
        'dbo.KASA K INNER JOIN GENINI G ON K.TUR=G.DEGER AND BOLUM='#39'-1005' +
        #39' AND DIL='#39'-1'#39
      
        'LEFT JOIN KREDILER KR ON K.REHBERID=KR.REHBERID AND K.MASRAFID=K' +
        'R.MASRAFID'
      'WHERE'
      'K.TUR IN (58) AND ISNULL(R,0)=0'
      ''
      ') AS MASRAFLISTESI '
      'WHERE')
    Left = 45
    Top = 288
  end
