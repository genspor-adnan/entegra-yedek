  object TabReferans: TADOQuery
    Connection = Tablo.cnn
    AfterOpen = TabReferansAfterOpen
    Parameters = <
      item
        Name = 'PKOD'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 30
        Value = Null
      end
      item
        Name = 'PKURUM'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 50
        Value = Null
      end
      item
        Name = 'PANAFIRMA'
        DataType = ftString
        NumericScale = 255
        Precision = 255
        Size = 50
        Value = Null
      end>
    SQL.Strings = (
      'SELECT KOD, FIRMA,  ANAFIRMA,  EVILCE, EVIL FROM REHBER'
      'WHERE '
      'ISNULL(KOD,'#39#39') LIKE :PKOD AND'
      'ISNULL(FIRMA,'#39#39') LIKE :PKURUM AND'
      'ISNULL(ANAFIRMA,'#39#39') LIKE :PANAFIRMA AND'
      ''
      'ISNULL(ARAMADACIKSIN,'#39'H'#39')='#39'E'#39
      'ORDER BY FIRMA')
    Left = 432
    Top = 174
  end
