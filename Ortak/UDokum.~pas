procedure TDokumDlg.DosyayaYazdr1Click(Sender: TObject);
var
  F: Textfile;
  DisNo, Ekle: integer;
  fmt, st, ss: string;
begin
  TabloDokum.SaveDialog1.Title := 'Kaydedilecek Dosya Adý';
  if TabloDokum.SaveDialog1.Execute then
  begin
    AssignFile(F, TabloDokum.SaveDialog1.FileName);
    if FileExists(TabloDokum.SaveDialog1.FileName) then
      if MessageDlg(OpenDialog1.FileName + ' adlý dosya zaten var. Üzerine yazýlsýn mý?',
        mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
        exit;
    try
      Rewrite(F);
    except
      on EInOutError do
        MessageDlg('Dosya oluþturmada hata var!!!', mtError, [mbOk], 0);
    end;

    TabloDokum.Query1.first;
    while not TabloDokum.Query1.eof do
    begin
      str := '';
      for i := 0 to TabloDokum.Query1.FieldCount - 1 do
      begin
        fmt := TabloDokum.Ini.ReadString(TabloDokum.TabDokum.FieldByName('RAPORADI').AsString, TabloDokum.Query1.Fields[i].FieldName, '%-,');
        fmt := copy(fmt, 1, pos(',', fmt) - 1);
        st := '';

        if Fmt[Length(Fmt)] = 't' then
          St := FormatDateTime('ddmmyyyy', TabloDokum.Query1.Fields[i].AsDateTime)
        else if Fmt[Length(Fmt)] = 'd' then
          st := Format(fmt, [TabloDokum.Query1.Fields[i].AsInteger])
        else if Fmt[Length(Fmt)] = 'c' then
        begin
          st := TabloDokum.Query1.Fields[i].AsString;
          while pos('.', st) > 0 do
            delete(st, pos('.', st), 1);
          while pos(' ', st) > 0 do
            delete(st, pos(' ', st), 1);
        end
        else if Fmt[Length(Fmt)] = 'þ' then
        begin
          ss := copy(TabloDokum.Query1.Fields[i].AsString, 1, 7);
          DisNo := StrToInt(copy(TabloDokum.Query1.Fields[i].AsString, 9, 1));
          if (ss = 'SAÐ ÜST') or (ss = 'Sað Üst') then
            Ekle := 0
          else if (ss = 'SOL ÜST') or (ss = 'Sol Üst') then
            Ekle := 8
          else if (ss = 'SAÐ ALT') or (ss = 'Sað Alt') then
            Ekle := 16
          else if (ss = 'SOL ALT') or (ss = 'Sol Alt') then
            Ekle := 24;
          st := '';
          for j := 0 to Ekle + disno do
            st := st + ' ';
          st := st + copy(TabloDokum.Query1.Fields[i].AsString, 11, 1);
          for j := Ekle + disno to 32 do
            st := st + ' '
        end
        else if Fmt[Length(Fmt)] = 'ö' then
        begin
          st := TabloDokum.Query1.Fields[i].AsString;
          if st = '0' then
            st := '<'
          else
            St := St + '-';

          if TabloDokum.Query1.Fields[i + 1].AsString = '0' then
            st := st + '>'
          else
            st := st + TabloDokum.Query1.Fields[i + 1].AsString;

          if st = '-' then
            st := TabloDokum.Query1.Fields[i + 2].AsString;
          Ekle := length(St);
          for j := Ekle to 10 do
            st := st + ' ';
          St := Copy(St, 1, 10);
        end
        else if Fmt[Length(Fmt)] = 'ç' then
        begin
          if (TabloDokum.Query1.Fields[i].AsString = '0') or
            (TabloDokum.Query1.Fields[i].AsString = ' ') then
            st := Format('%-10s', [TabloDokum.Query1.Fields[i + 1].AsString])
          else
            st := Format('%-10s', [TabloDokum.Query1.Fields[i].AsString]);
          St := Copy(St, 1, 10);
        end
        else if Fmt[Length(Fmt)] = 's' then
          st := Format(fmt, [TabloDokum.Query1.Fields[i].AsString]);
        str := str + st;
//          end else
//             s := s + TabloDokum.Query1.Fields[i].AsString;
      end;
      Writeln(F, str);
      TabloDokum.Query1.next;
    end;
    CloseFile(F);
    ShowMessage('Dosyaya yazma iþlemi sona erdi...');
  end;
end;

