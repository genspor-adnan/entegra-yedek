procedure TDokumDlg.ComBoxDropDown(Sender: TObject);
  procedure ComboYukle(Tablo, Alan, Benzer: string; Sorgu: string);
  begin
    TComboBox(Sender).Clear;
    TabloDokum.Query2.Close;
    if sorgu <> '' then
      TabloDokum.Query2.SQL.Text := sorgu
    else
      TabloDokum.Query2.SQL.Text := 'Select ' + Alan + ' From ' + Tablo + ' where ' + Alan + ' like ''' + Benzer + '%'' order by ' + Alan;
    TabloDokum.Query2.Open;
    while not TabloDokum.Query2.eof do
    begin
      TComboBox(Sender).Items.Add(TabloDokum.Query2.Fields[0].AsString);
      TabloDokum.Query2.next;
    end;
  end;

  procedure DoktorListeleme;
  var x: word;
  begin
    DoktorDlg.DBNavigator.VisibleButtons := [];
    DoktorDlg.AramaKod.Text := '';
    DoktorDlg.AramaAd.Text := TComboBox(Sender).Text;
    DoktorDlg.AramaUz.Text := '';
    DoktorDlg.TabDoktor.Close;
    DoktorDlg.TabDoktor.LockType := ltReadOnly;
    DoktorDlg.AramaAdKeyUp(Self, x, []);
    DoktorDlg.ShowModal;
    if DoktorDlg.ModalResult = mrOK then
      TComboBox(Sender).Text := Trim(DoktorDlg.TabDoktor.Fields[1].AsString);
    DoktorDlg.TabDoktor.Close;
    DoktorDlg.TabDoktor.LockType := ltOptimistic;
  end;
var
  SQLSt: string;
begin
  i := StrToInt(Copy(TComboBox(Sender).Name, 7, length(TComboBox(Sender).Name)));
  j := 1;
  TabloDokum.TabKosul.First;
  while j < i do
  begin
    TabloDokum.TabKosul.Next;
    inc(j, 5);
  end;
  if TabloDokum.TabKosul.FieldByName('COMBOICERIK').AsString <> '' then
  begin
    if Copy(TabloDokum.TabKosul.FieldByName('COMBOICERIK').AsString, 1, 1) = '{' then
      SQLSt := Copy(TabloDokum.TabKosul.FieldByName('COMBOICERIK').AsString, pos('}', TabloDokum.TabKosul.FieldByName('COMBOICERIK').AsString) + 1, length(TabloDokum.TabKosul.FieldByName('COMBOICERIK').AsString))
    else
      SQLSt := TabloDokum.TabKosul.FieldByName('COMBOICERIK').AsString;
    try
      ComboYukle('', '', '', SQLSt);
    except
    end;
    exit;
  end;

  if TabloDokum.TabKosul.FieldByName('ALAN').AsString = 'POLIKLINIK' then
    ComboYukle('POLIKLNK', 'AD', '', '')
  else if TabloDokum.TabKosul.FieldByName('ALAN').AsString = 'DOKTOR' then
    ComboYukle('DOKTOR', 'DOKTOR', '', '')
  else if TabloDokum.TabKosul.FieldByName('ALAN').AsString = 'DOKTORLAR' then
  begin
//      ComboYukle('DOKTORLAR', 'DOKTOR','')
    DoktorListeleme;
    Repaint;
  end
  else if TabloDokum.TabKosul.FieldByName('ALAN').AsString = 'REFERANS' then
    ComboYukle('REFERANS', 'REFERANS', '', '')
  else if TabloDokum.TabKosul.FieldByName('ALAN').AsString = 'KURUM' then
    ComboYukle('KURUM', 'KURUM', '', '')
  else if pos('TARIH', TabloDokum.TabKosul.FieldByName('ALAN').AsString) > 0 then
  begin
    TComboBox(Sender).Items.Clear;
    TComboBox(Sender).Items.Add(DateTimeToStr(Date))
  end
  else if TabloDokum.TabKosul.FieldByName('ALAN').AsString = 'ISLEMADI' then
    ComboYukle('ISLEMLER', 'ISLEMADI', TComboBox(Sender).Text, '')
  else
    TabloDokum.Ini.ReadSection(TabloDokum.TabKosul.FieldByName('ALAN').AsString, TComboBox(Sender).Items);
end;

