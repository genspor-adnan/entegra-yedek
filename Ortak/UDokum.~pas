procedure TDokumDlg.DokumIslemi;
var Kosullar: array[1..10] of string[50];
  Yeri: integer;
  s: string;
begin
  Komut.Clear;
  KosullariKaydet;
//  TabloDokum.TabDokum.Refresh;
//  DokumSartDlg.TabDokum.FindKey([TabDokum.FieldByName('RAPORADI').AsString]);
  if TabloDokum.TabDokum.FieldByName('SQL').AsString <> '' then
  begin
    i := 0; //Koþullarý Diziye Al
    TabloDokum.TabKosul.First;
    while not TabloDokum.TabKosul.eof do
    begin
      inc(i);
      if pos('TARIH', TabloDokum.TabKosul.FieldByName('ALAN').AsString) > 0 then
      begin
        if pos(':', TabloDokum.TabKosul.FieldByName('DEGER').AsString) > 0 then
          Kosullar[i] := FormatDateTime('mm/dd/yyyy hh:nn', TabloDokum.TabKosul.FieldByName('DEGER').AsDateTime)
        else
          Kosullar[i] := FormatDateTime('mm/dd/yyyy', TabloDokum.TabKosul.FieldByName('DEGER').AsDateTime)
      end
      else
        Kosullar[i] := TabloDokum.TabKosul.FieldByName('DEGER').AsString;
      TabloDokum.TabKosul.next;
    end;

    Komut.Assign(TabloDokum.TabDokum.FieldByName('SQL'));
    TabloDokum.Query1.Close;
    TabloDokum.Query1.SQL.Clear;
    Komut.Text := StringReplace(komut.Text, ':KAKOD', Kullanan, [rfReplaceAll]);
    Komut.Text := StringReplace(komut.Text, ':KA', KullanAdi, [rfReplaceAll]);
    Komut.Text := StringReplace(komut.Text, ':SIRKETID', inttostr(SirketKodu), [rfReplaceAll]);
    TABLO.TabAraSQL.Close;
    TABLO.TabAraSQL.SQL.Text := 'Select * from KULLAN where KULLANICI=''' + Kullanan + ''';';
    TABLO.TabAraSQL.Open;
    Komut.Text := StringReplace(komut.Text, ':KULLANICIADI', '''' + TABLO.TabAraSQL.fieldbyname('KULLANICIADI').AsString + '''', [rfReplaceAll]);
    Komut.Text := StringReplace(komut.Text, ':UZMANLIK', '''' + TABLO.TabAraSQL.fieldbyname('UZMANLIK').AsString + '''', [rfReplaceAll]);
    for i := 0 to Komut.Count - 1 do
    begin
      while Pos('KOSUL', Komut.Strings[i]) > 0 do
      begin
        Yeri := Pos('KOSUL', Komut.Strings[i]) - 1;
        s := copy(Komut.Strings[i], 1, Yeri);
        s := s + Kosullar[StrToInt(copy(Komut.Strings[i], Yeri + 6, 1))];
        s := s + Copy(Komut.Strings[i], Yeri + 7, length(Komut.Strings[i]) - Yeri);
        Komut.Strings[i] := s;
      end;

      Yeri := pos('ORDER BY', uppercase(Komut.Strings[i]));

      if (Siralama > '0') and (pos('.', Siralama) = 0) and
        (Pos('.' + Siralama, Komut.Strings[i]) > 0) then
      begin //Siralama alanýnýn önünde tablo adý varmý DOSYANO > KIMLIK.DOSYANO
        s := Komut.Strings[i];
        Siralama := '.' + Siralama;
        j := pos(Siralama, s) - 1;
        while (s[j] in ['A'..'Z']) and (j > 0) do
        begin
          Siralama := s[j] + Siralama;
          dec(j);
        end;
      end;

      if (Siralama > '0') and (Yeri > 0) then
      begin
        s := copy(Komut.Strings[i], 1, Yeri + 8);
        s := ' ' + s + ' ' + Siralama + SiraYonu;
        Komut.Strings[i] := s;
      end;
{       if (OrderField>'0')and(Yeri>0) then begin
          s := copy(Komut.Strings[i], 1, Yeri+8);
          s := s + OrderField;
          Komut.Strings[i] := s;
       end;    }
    end;
    TabloDokum.Query1.SQL := Komut;
    TabloDokum.Query1.open;
  end
  else
  begin
//   TabloDokum.Ini.ReadSection(TabloDokum.TabKosul.FieldByName('ALAN').AsString, TComboBox(Sender).Items);
    if KomutOlustur then
    begin
      TabloDokum.Query1.Close;
      TabloDokum.Query1.SQL.Clear;
      TabloDokum.Query1.SQL := Komut;
      TabloDokum.Query1.open;
    end;
  end;
end;

