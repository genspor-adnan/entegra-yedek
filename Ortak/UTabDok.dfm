  object TabDokum: TADOQuery
    Connection = Tablo.cnn
    BeforeEdit = TabDokumBeforeEdit
    BeforePost = TabDokumBeforePost
    AfterPost = TabDokumAfterPost
    BeforeDelete = TabDokumBeforeDelete
    OnNewRecord = TabDokumNewRecord
    Parameters = <
      item
        Name = 'M'
        Size = -1
        Value = Null
      end
      item
        Name = 'KA'
        Size = -1
        Value = Null
      end
      item
        Name = 'KA'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'SELECT * FROM DOKUMLER D WHERE MODUL LIKE :M AND'
      'RAPORADI COLLATE TURKISH_CI_AS IN '
      
        '(CASE (SELECT COUNT(*) FROM KULHAR WHERE KULLANICIADI COLLATE TU' +
        'RKISH_CI_AS = :KA AND EKRAN COLLATE TURKISH_CI_AS = D.RAPORADI) '
      '     WHEN 0 THEN D.RAPORADI ELSE  '
      
        #9' (SELECT  EKRAN COLLATE TURKISH_CI_AS   FROM  KULHAR WHERE  KUL' +
        'LANICIADI = :KA AND GORME = 1 AND EKRAN COLLATE TURKISH_CI_AS = ' +
        'D.RAPORADI )  '
      #9' END)'
      'ORDER BY GRUBU,RAPORADI')
    Left = 16
    Top = 8
  end
