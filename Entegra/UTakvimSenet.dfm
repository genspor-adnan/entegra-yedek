  object DtsSenetler: TDataSource
    DataSet = TabSenetler
    Left = 661
    Top = 217
  end
  object TabSenetler: TFDQuery
    Connection = Tablo.FDCnn
    ParamData = <
      item
        Name = 'PID'
        Size = -1
        Value = Null
      end>
    SQL.Strings = (
      'select R.FIRMA,'
      
        '    ADRES=((SELECT TOP 1 BILGI FROM REHBERAYAR RA INNER JOIN REH' +
        'BERBILGI RB ON RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_' +
        'ID=R.ID AND RA.VARSAYILAN=2)+'#39' '#39
      
        '    +(SELECT TOP 1  BILGI FROM REHBERAYAR RA INNER JOIN REHBERBI' +
        'LGI RB ON RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=R.' +
        'ID AND RA.VARSAYILAN=4)),'
      
        '   ILCE=(SELECT  TOP 1 BILGI FROM REHBERAYAR RA INNER JOIN REHBE' +
        'RBILGI RB ON RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID' +
        '=R.ID AND RA.VARSAYILAN=6),'
      
        '    IL=(SELECT TOP 1  BILGI FROM REHBERAYAR RA INNER JOIN REHBER' +
        'BILGI RB ON RA.SIRA=RB.SIRA AND RA.YERI=RB.YERI WHERE RB.YER_ID=' +
        'R.ID AND RA.VARSAYILAN=8),'
      
        '    VERGI=(LTRIM(RTRIM(ISNULL((SELECT TOP 1  BILGI FROM REHBERAY' +
        'AR RA INNER JOIN REHBERBILGI RB ON RA.SIRA=RB.SIRA AND RA.YERI=R' +
        'B.YERI WHERE RB.YER_ID=R.ID AND RA.VARSAYILAN=20),'#39#39')))),'
      
        #9'+'#39' / '#39'+(LTRIM(RTRIM(ISNULL((SELECT  TOP 1 BILGI FROM REHBERAYAR' +
        ' RA INNER JOIN REHBERBILGI RB ON RA.SIRA=RB.SIRA AND RA.YERI=RB.' +
        'YERI WHERE RB.YER_ID=R.ID AND RA.VARSAYILAN=22),'#39#39')))),'
      
        #9'YAZIYLATUTAR='#39'# '#39'+DBO.fn_MoneyToText(S.TUTAR,'#39'L'#304'RA'#39','#39'KURU'#350#39')+'#39' ' +
        '#'#39','
      '    S.*'
      ' from '
      '   SENETLER S INNER JOIN '
      '   REHBER R ON '
      '            R.ID=S.REHBERID'
      ''
      'where '
      '  S.ID=:PID')
    Left = 659
    Top = 260
  end
end

