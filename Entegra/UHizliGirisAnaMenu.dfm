    object SQLTahsil: TMemo
      Left = 668
      Top = 86
      Width = 676
      Height = 38
      Lines.Strings = (
        
          'select TUR=21,HESAPID=0, TAHSILAD='#39'Nakit'#39', TUTAR=NULL, KUR='#39'@KUR' +
          #39', RESIM=null '
        'union all'
        
          'select TUR=25,HESAPID=ID, TAHSILAD=ADI, TUTAR=NULL, KUR='#39'@KUR'#39', ' +
          'RESIM from POS where DURUM = 1 and SUBEID=:SubeId'
        'union all'
        
          'select TUR=26,HESAPID=ID, TAHSILAD=ADI, TUTAR=NULL, KUR='#39'@KUR'#39', ' +
          'RESIM from PARA_KUPON where TUR = 26 and DURUM = 1 order by 1  ')
      TabOrder = 1
      Visible = False
      WordWrap = False
    end
  end
