          <script>function hl7Segmentler(ham) { return String(ham).replace(/\n/g, &apos;\r&apos;).split(&apos;\r&apos;).filter(function (s) { return s.length &gt; 0; }); }
function hl7Alan(ham, seg, no) {
  var s = hl7Segmentler(ham).filter(function (x) { return x.substr(0, 3) == seg; })[0];
  if (!s) return null;
  var f = s.split(&apos;|&apos;);
  return seg == &apos;MSH&apos; ? (f[no - 1] || &apos;&apos;) : (f[no] || &apos;&apos;);
}
var ham = String(connectorMessage.getRawData());
var hatalar = [];
if (hl7Alan(ham, &apos;MSH&apos;, 12) != &apos;2.3.1&apos;) hatalar.push(&apos;0002: HL7 surumu 2.3.1 olmali&apos;);
var pid4 = String(hl7Alan(ham, &apos;PID&apos;, 4) || &apos;&apos;).split(&apos;^&apos;);
if (pid4[3] != &apos;PASS&apos; &amp;&amp; !/^[1-9][0-9]{10}$/.test(pid4[0])) hatalar.push(&apos;PID-4 gecerli TCKN degil (benzetim)&apos;);
if (String(hl7Alan(ham, &apos;PV1&apos;, 19) || &apos;&apos;).split(&apos;^&apos;)[0] == &apos;&apos;) hatalar.push(&apos;0278: PV1-19 Visit No alani bos gecilemez&apos;);
var obr = hl7Alan(ham, &apos;OBR&apos;, 4);
if (obr !== null) {
  var o4 = String(obr).split(&apos;^&apos;);
  if (o4.length &lt; 2 || o4[0] == &apos;&apos; || o4[1] == &apos;&apos;) hatalar.push(&apos;0008: OBR-4-1 ve OBR-4-2 alanlari eksik ya da hatali&apos;);
  var o24 = String(hl7Alan(ham, &apos;OBR&apos;, 24) || &apos;&apos;);
  if (o24.length &lt; 2 || o24.length &gt; 16) hatalar.push(&apos;0003: OBR-24 alani en az iki karakter Modalite olmali&apos;);
}
var kod = hatalar.length == 0 ? &apos;AA&apos; : &apos;AE&apos;;
var ack = ACKGenerator.generateAckResponse(ham, kod, hatalar.join(&apos; | &apos;));
responseMap.put(&apos;teletip_ack&apos;, ResponseFactory.getSentResponse(ack));
channelMap.put(&apos;sonuc&apos;, kod);
</script>
