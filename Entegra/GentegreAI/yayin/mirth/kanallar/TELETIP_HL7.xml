          <script>function hl7Segmentler(ham) { return String(ham).replace(/\n/g, &apos;\r&apos;).split(&apos;\r&apos;).filter(function (s) { return s.length &gt; 0; }); }
function hl7Alan(ham, seg, no) {
  var s = hl7Segmentler(ham).filter(function (x) { return x.substr(0, 3) == seg; })[0];
  if (!s) return null;
  var f = s.split(&apos;|&apos;);
  return seg == &apos;MSH&apos; ? (f[no - 1] || &apos;&apos;) : (f[no] || &apos;&apos;);
}
var ham = connectorMessage.getRawData();
channelMap.put(&apos;mesajTuru&apos;, hl7Alan(ham, &apos;MSH&apos;, 9) || &apos;&apos;);
channelMap.put(&apos;kontrolNo&apos;, hl7Alan(ham, &apos;MSH&apos;, 10) || &apos;&apos;);
var acc = hl7Alan(ham, &apos;OBR&apos;, 18) || String(hl7Alan(ham, &apos;ORC&apos;, 2) || &apos;&apos;).split(&apos;^&apos;)[0];
channelMap.put(&apos;accession&apos;, acc || &apos;&apos;);
channelMap.put(&apos;emir&apos;, String(hl7Alan(ham, &apos;ORC&apos;, 1) || &apos;&apos;));
</script>
