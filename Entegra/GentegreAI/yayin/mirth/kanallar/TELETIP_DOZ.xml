            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <script>var ham = String(msg == null ? &apos;&apos; : msg);
var mesaj = String(responseStatusMessage == null ? &apos;&apos; : responseStatusMessage);
var hata = String(responseErrorMessage == null ? &apos;&apos; : responseErrorMessage);
var kod = ((mesaj + &apos; &apos; + hata).match(/0x([0-9A-Fa-f]{1,4})/) || [])[1] || &apos;&apos;;
var x = ham.match(/tag00000900[^&gt;]*&gt;([^&lt;]*)&lt;/); if (kod == &apos;&apos; &amp;&amp; x) kod = Number(x[1]).toString(16);
var y = ham.match(/tag00000902[^&gt;]*&gt;([^&lt;]*)&lt;/); var yorum = y ? y[1] : &apos;&apos;;
if (kod == &apos;&apos; &amp;&amp; String(responseStatus) == &apos;SENT&apos;) kod = &apos;0&apos;;
while (kod.length &gt; 0 &amp;&amp; kod.length &lt; 4) kod = &apos;0&apos; + kod;
var metin = &apos;DURUM=&apos; + responseStatus + &apos;\nKOD=&apos; + kod.toUpperCase() + &apos;\nYORUM=&apos; + yorum.replace(/[\r\n]+/g, &apos; &apos;) +
  &apos;\nMESAJ=&apos; + (mesaj + (hata.length &gt; 0 ? &apos; &apos; + hata : &apos;&apos;)).replace(/[\r\n]+/g, &apos; &apos;);
responseMap.put(&apos;doz_yanit&apos;, ResponseFactory.getSentResponse(metin));
channelMap.put(&apos;kod&apos;, kod);
</script>
