  object TabKodYetki: TFDQuery
    Connection = Tablo.FDCnn
    ParamData = <>
    SQL.Strings = (
      'SELECT DISTINCT BILGI '
      'FROM KULHAR'
      'WHERE KULLANICIADI= :PKULLANICIADI '
      'AND EKRAN LIKE '#39'Gent-Kod Yetki%'#39'  '
      'ORDER BY 1')
    Left = 280
    Top = 152
  end
