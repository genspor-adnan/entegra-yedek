  object TabKullanicilar: TFDQuery
    Connection = Tablo.FDCnn
    AfterScroll = TabKullanicilarAfterScroll
    ParamData = <>
    SQL.Strings = (
      'SELECT KULLANICIADI FROM KULLAN '
      'WHERE KULLANICIADI LIKE :PKULLANICI'
      'ORDER BY 1')
    Left = 24
    Top = 184
  end
