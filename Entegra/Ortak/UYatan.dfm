  object TabYatan: TADOQuery
    Connection = Tablo.cnn
    CursorType = ctStatic
    AfterOpen = TabYatanAfterOpen
    Parameters = <>
    SQL.Strings = (
      'Select '
      #9'Y.BINA,Y.KAT,Y.ODA,Y.TUR, Y.YATAK,Y.SERVISID, Y.DURUM, Y.SEC,'
      '        Y.DOSYANO,Y.GELISNO,ADSOYAD = AD+'#39' '#39'+SOYAD,  '
      #9'UZMANLIK,G.DOKTOR, '
      #9'G.GIRISTARIH, '
      #9'KALDIGIGUN = case '
      #9'when datediff(d,G.GIRISTARIH, GetDate())  < 1 '
      'then 1 '
      #9'else datediff(d,G.GIRISTARIH, GetDate()) '
      #9'end ,'
      #9'G.TEDAVI, '
      'G.CIKISTARIH '
      'FROM   '
      #9'YATAKDURUM Y'
      #9'LEFT OUTER JOIN KIMLIK K  '
      #9#9'ON K.DOSYANO = Y.DOSYANO '
      #9'LEFT OUTER JOIN GELISLER G '
      '        '#9'ON Y.DOSYANO = G.DOSYANO AND'
      '        '#9'   Y.GELISNO = G.GELISNO '
      '        LEFT OUTER JOIN DOKTOR D  '
      '        ON G.DOKTORKOD = D.DOKTORKOD'
      'ORDER BY'
      #9'1,2  ')
    Left = 208
    Top = 185
  end
