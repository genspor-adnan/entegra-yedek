  object TabKullanici: TFDQuery
    Connection = Tablo.FDCnn
    ParamData = <>
    SQL.Strings = (
      'select '
      '       Gen.*, '
      #9'   KULLANICI =CASE '
      #9'   --T'#252'm'
      #9'   WHEN SIRA=5 THEN '#39'T'#252'm Kullan'#305'c'#305'lar'#39' '
      #9'   --ki'#351'i/'#351'ube'
      
        #9'   WHEN SIRA in (1,4) THEN (SELECT FIRMA FROM REHBER WHERE ID=G' +
        'en.DEGER )'
      '       --departman'
      
        #9'  WHEN SIRA=3 THEN  ( SELECT G.ANAHTAR from GENINI G where G.BO' +
        'LUM=-2251 AND DEGER = Gen.DEGER AND G.DIL=-1 )'
      '       --g'#246'rev'
      
        #9'   WHEN SIRA=2 THEN  ( SELECT G.ANAHTAR from GENINI G where G.B' +
        'OLUM=-2252 AND DEGER = Gen.DEGER AND G.DIL=-1 )'
      #9'   END'
      ''
      'from '
      #9'GENINI Gen'
      'where '
      #9'Gen.DIL = :PRehID')
    Left = 273
    Top = 178
  end
  object DtsKullanici: TDataSource
    DataSet = TabKullanici
    Left = 274
    Top = 124
  end
