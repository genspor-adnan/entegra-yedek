object HaklarDlg: THaklarDlg
  Left = 0
  Top = 0
  BorderIcons = [biSystemMenu, biMaximize]
  Caption = 'Haklar'
  ClientHeight = 472
  ClientWidth = 965
  Color = clBtnFace
  Font.Charset = DEFAULT_CHARSET
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'Tahoma'
  Font.Style = []
  OldCreateOrder = False
  Position = poScreenCenter
  WindowState = wsMaximized
  PixelsPerInch = 96
  TextHeight = 13
  object cxRichEdit1: TcxRichEdit
    Left = 0
    Top = 0
    Align = alClient
    Properties.ReadOnly = True
    Properties.ScrollBars = ssVertical
    Properties.SelectionBar = True
    Lines.Strings = (
      'Garanti, Kullan'#305'm ve '#304'ade Ko'#351'ullar'#305
      
        #214'nemli: Bu lisans s'#246'zle'#351'mesinde belirtilen haklar'#305' ve y'#252'k'#252'ml'#252'l'#252'k' +
        'leri dikkatle okuyunuz.'
      
        'Bu s'#246'zle'#351'me SON KULLANICI olan siz ve Granit Bilgisayar '#304'leti'#351'im' +
        ' ve Destek Hizmetleri San. Tic. Ltd. '#350'ti. aras'#305'nda yap'#305'lan bir s' +
        #246'zle'#351'medir. Kimi yerde Granit, '#8220'biz'#8221', '#8220'bize'#8221', '#8220'bizim'#8221' veya Grani' +
        't '
      
        'Bilgisayar olarak an'#305'lacakt'#305'r. Bu s'#246'zle'#351'me, s'#246'zle'#351'menin ge'#231'erli ' +
        'oldu'#287'u s'#252're boyunca kulland'#305#287#305'n'#305'z g'#252'ncelle'#351'tirmeler de dahil her' +
        ' t'#252'rl'#252' Granit Bilgisayar yaz'#305'l'#305'm'#305', '#252'r'#252'nleri veya hizmetlerine '
      'uygulanacakt'#305'r.'
      
        'Yaz'#305'l'#305'm'#305' bilgisayar'#305'n'#305'za y'#252'klemeniz veya kullanman'#305'z, s'#246'zle'#351'me '#351 +
        'artlar'#305'n'#305' kabul etti'#287'inizi g'#246'sterir.'
      'I- '#39'SON KULLANICI'#39' n'#305'n Hak Ve Y'#252'k'#252'ml'#252'l'#252'kleri'
      
        '1. '#39'SON KULLANICI'#39', YAZILIM lisans '#351'ifresini, kullanma ve tan'#305'tm' +
        'a belgesinde yaz'#305'l'#305' '#351'artlara uygun olarak ve yine burada belirli' +
        ' ekipman ve donan'#305'mla kullanmay'#305' kabul, taahh'#252't ve beyan eder. '#39 +
        'SON '
      
        'KULLANICI'#39', yukar'#305'da yaz'#305'l'#305' h'#252'kme ayk'#305'r'#305' davranmas'#305' sebebi ile s' +
        #246'zle'#351'me konusu '#252'r'#252'nde meydana gelecek hasar ve ziyanlardan dolay' +
        #305' i'#351' bu s'#246'zle'#351'menin bend IV- madde 3.4. madde h'#252'k'#252'mlerinden '
      
        'yararlanma hakk'#305'n'#305'n ortadan kalkaca'#287#305'n'#305' bildi'#287'ini beyan ve kabul' +
        ' eder.'
      
        '2. '#39'SON KULLANICI'#39', YAZILIM'#39' '#305' sadece tek bir bilgisayara veya y' +
        'erel a'#287' ortam'#305'na y'#252'kleyece'#287'ini (Local Area Network) ve yaln'#305'zca ' +
        'bu ortamlarda kullanaca'#287#305'n'#305', herhangi bir ara'#231'la ve herhangi bir' +
        ' '
      
        #351'ekilde s'#252'rekli veya ge'#231'ici olarak ba'#351'ka bir ortama aktarmayaca'#287 +
        #305'n'#305' kabul, taahh'#252't ve beyan eder.'
      
        '3. '#39'SON KULLANICI'#39'; YAZILIM, '#231'ok kullan'#305'c'#305'l'#305' sistemi destekliyor' +
        ' ise a'#287'da birden fazla bilgisayara kurup '#231'al'#305#351't'#305'r'#305'labilece'#287'ini, ' +
        'a'#287'daki her bir bilgisayar i'#231'in lisans almas'#305' gerekti'#287'i hususunu ' +
        've bir YAZILIM '
      
        'lisans'#305'n'#305'n payla'#351#305'lamayaca'#287#305'n'#305' ve YAZILIM'#39' '#305'n de'#287'i'#351'ik bilgisayar' +
        'larda ayn'#305' anda kullan'#305'lamayaca'#287#305'n'#305' bildi'#287'ini beyan ve kabul ede' +
        'r.'
      
        '4. YAZILIM, Server-Client '#351'eklinde kullan'#305'l'#305'yor ise; '#39'SON KULLAN' +
        'ICI'#39', '#231'al'#305#351't'#305'r'#305'labilecek maksimum program'#305' lisans al'#305'rken belirt' +
        'ilen, client say'#305's'#305' kadar di'#287'er bilgisayarlara kurma hakk'#305'na hai' +
        'zdir.'
      
        '5. '#39'SON KULLANICI'#39', indirece'#287'i ve y'#252'kleyece'#287'i demo s'#252'r'#252'm'#252'n'#252', GRA' +
        'N'#304'T'#39' in belirledi'#287'i kay'#305't adedi ve s'#252'resince kullanaca'#287#305'n'#305', her ' +
        'ne sebeple olursa olsun, ticari veya mesleki ama'#231'larla veya di'#287'e' +
        'r kar '
      
        'getirici sebeplerle kullanmayaca'#287#305'n'#305' kabul, taahh'#252't ve beyan ede' +
        'r.'
      '6. '#39'SON KULLANICI'#39
      
        'a. Bu Lisans S'#246'zle'#351'mesi ile izin verilenler d'#305#351#305'nda YAZILIM ve d' +
        'ok'#252'mantasyonu '#231'o'#287'alt'#305'p kullanmayaca'#287#305'n'#305', YAZILIM'#39' '#305' kaynak koda ' +
        'd'#246'n'#252#351't'#252'rmeyece'#287'ini ve tekrar derleme i'#351'lemi yapmayaca'#287#305'n'#305','
      
        'b. GRAN'#304'T'#39' in yaz'#305'l'#305' onay'#305' olmadan YAZILIM'#39' '#305', ba'#351'ka bir ki'#351'iye ' +
        'da'#287#305'tmayaca'#287#305'n'#305', '#246'd'#252'n'#231' vermeyece'#287'ini, kiraya vermeyece'#287'ini, satm' +
        'ayaca'#287#305'n'#305', topluma iletmeyece'#287'ini,'
      
        'c. YAZILIM ve dok'#252'mantasyonunu de'#287'i'#351'tirmeyece'#287'ini, uyarlamayaca'#287 +
        #305'n'#305' veya YAZILIM ve dok'#252'mantasyondan yola '#231#305'karak esinlenmi'#351' ese' +
        'rler yaratmayaca'#287#305'n'#305' Kabul, beyan ve taahh'#252't eder.'
      'II- GRAN'#304'T'#39' in Hak Ve Y'#252'k'#252'ml'#252'l'#252'kleri'
      
        '1. '#39'SON KULLANICI'#39' n'#305'n, bend I, madde 1.-2.-3.-5.-6 h'#252'k'#252'mlerine ' +
        'ayk'#305'r'#305' davranmas'#305' halinde, GRAN'#304'T hi'#231'bir ihtara gerek kalmaks'#305'z'#305 +
        'n, her t'#252'rl'#252' yasal ba'#351'vuru ve talep haklar'#305'n'#305' kullanma hakk'#305'na '
      
        'haizdir. '#39'SON KULLANICI'#39' n'#305'n yedekleme amac'#305' ile ald'#305#287#305' kopyalar' +
        ' bu madde h'#252'km'#252'n'#252'n istisnas'#305' olup; '#39'SON KULLANICI'#39' yedek ama'#231'l'#305' ' +
        'kopya alma hakk'#305'na haizdir.'
      
        '2. GRAN'#304'T, '#39'SON KULLANCI'#39' i'#351'letmenin, program devri talebi halin' +
        'de, "Lisans Sistemi ve Program Sat'#305#351'lar'#305'nda Uygulanan Esaslar" d' +
        'aki uygun h'#252'k'#252'mleri yerine getirece'#287'ini kabul, beyan ve taahh'#252't '
      'eder.'
      
        '3. GRAN'#304'T, '#39'SON KULLANCI'#39' n'#305'n talebi '#252'zerine ve destek karar'#305' ke' +
        'ndisinde olmak '#252'zere, '#39'SON KULLANCI'#39' ya, teknik destek sa'#287'layabi' +
        'lir. Destek hizmeti esnas'#305'nda edinilen ve geli'#351'tirilen teknik '
      
        'materyal ve bilgilerin fikri m'#252'lkiyet hakk'#305' GRAN'#304'T '#39' e ait olup,' +
        ' '#39'SON KULLANCI'#39' bu konuda herhangi bir hak talebinde bulunamaz.'
      ''
      'III- Garanti ve '#304'ade Ko'#351'ullar'#305
      
        '1. GRAN'#304'T, problemli olan YAZILIM'#39' lar'#305' ve yaz'#305'l'#305' dok'#252'manlar'#305' fa' +
        'tura tarihinden itibaren ve fatura ile birlikte, en ge'#231' 30 g'#252'n i' +
        #231'inde iade edildi'#287'i takdirde yenisi ile de'#287'i'#351'tirir veya bedeli k' +
        'ar'#351#305'l'#305#287#305'nda iade '
      
        'al'#305'r. Al'#305'c'#305' bu hakk'#305'n'#305' faturas'#305' ile birlikte sat'#305'n ald'#305#287#305' Yetkil' +
        'i Sat'#305'c'#305'ya ('#199#246'z'#252'm Orta'#287#305') na ba'#351'vurarak kullan'#305'r. Belirtilen s'#252'r' +
        'eden sonra kullan'#305'c'#305' ay'#305'pl'#305' mal itiraz'#305'nda bulunamaz. Bu istisna' +
        'n'#305'n d'#305#351#305'nda '
      'YAZILIM'#39' lar geri iade edilemez, yenisi ile de'#287'i'#351'tirilemez.'
      
        '2. GRAN'#304'T; '#304#351'letim sistemi ve donan'#305'm ar'#305'zas'#305'ndan, network ba'#287'la' +
        'nt'#305' hatalar'#305'ndan, vir'#252's ve kullan'#305'c'#305' hatalar'#305'ndan kaynaklanacak ' +
        'bilgi kay'#305'plar'#305'ndan sorumlu tutulamaz. B'#246'yle bir durumda GRAN'#304'T,' +
        ' '
      
        'bozulmu'#351' olan lisansl'#305' YAZILIM'#39#305', i'#351' bu hizmet kar'#351#305'l'#305#287#305' olan hi' +
        'zmet bedeli ve masraf'#305'n GRAN'#304'T'#39' e '#246'denmesi halinde yenilemeyi ta' +
        'ahh'#252't eder.'
      
        '3. GRAN'#304'T'#39' in mali sorumlulu'#287'u, son kullan'#305'c'#305'n'#305'n, YAZILIM'#39' '#305' sat' +
        #305'n ald'#305#287#305' tarihte '#246'demi'#351' oldu'#287'u lisans bedeli ile s'#305'n'#305'rl'#305'd'#305'r.'
      
        '4. GRAN'#304'T, YAZILIM'#39' '#305'n i'#351'levini yerine getirmesi i'#231'in gerekli az' +
        'ami '#246'zeni g'#246'stermektedir. GRAN'#304'T geli'#351'tirdi'#287'i YAZILIM'#39' '#305'n hatas'#305 +
        'z, kusursuz ve m'#252'kemmel oldu'#287'u ve kullan'#305'c'#305'n'#305'n '#246'zel isteklerini ' +
        'tamamen '
      'kar'#351#305'layaca'#287#305' '#351'eklinde bir iddia ve taahh'#252'tte bulunmaz.'
      
        '5. YAZILIM, YAZILIM'#39' a uygun ekipman ve kalifiye elemanlarla ve ' +
        'kullan'#305'm k'#305'lavuzuna uygun olarak kullan'#305'lmal'#305'd'#305'r. GRAN'#304'T m'#252#351'teri' +
        'sine YAZILIM'#39' '#305'n kullan'#305'lmas'#305' esnas'#305'nda, hizmet bedeli kar'#351#305'l'#305#287#305 +
        ', '
      
        'GRAN'#304'T taraf'#305'ndan yeterlili'#287'i onaylanana dek e'#287'itim almas'#305'n'#305' tav' +
        'siye eder ve YAZILIM'#39' '#305'n uygun ekipman ve kalifiye elemanlarca k' +
        'ullan'#305'lmamas'#305'ndan, kullan'#305'm k'#305'lavuzuna ayk'#305'r'#305' kullan'#305'lmas'#305'ndan v' +
        'eya '
      
        'yeterli e'#287'itimin GRAN'#304'T yetkililerinden al'#305'nmamas'#305'ndan do'#287'an zar' +
        'arlardan veya zarar tehlikelerinden, GRAN'#304'T ve GRAN'#304'T Sat'#305#351' Biri' +
        'mleri sorumlu de'#287'ildir.'
      
        '6. GRAN'#304'T veya Sat'#305#351' Birimleri, olu'#351'an zarar'#305'n olas'#305'l'#305#287#305'ndan '#246'nc' +
        'eden haberdar edilmi'#351' olsalar dahi YAZILIM'#39' '#305'n kullan'#305'm'#305'ndan ya ' +
        'da kullan'#305'lamamas'#305'ndan do'#287'an veya bunlarla ili'#351'kili herhangi bir' +
        ' '#246'zel, '
      
        'mali, dolayl'#305', dolays'#305'z vaki hi'#231'bir zarardan ( '#350'ah'#305'slara olan za' +
        'rar, kar kayb'#305', i'#351'in durmas'#305', i'#351'le ilgili bilgilerin kayb'#305', g'#246're' +
        'vin yerine getirilmemesi, iyi niyet veya makul dikkatin g'#246'steril' +
        'memesi, ihmal ve '
      
        'her nas'#305'l olursa olsun t'#252'm dolayl'#305' zarar, ziyan ve cezai tazmina' +
        't dahil olmak '#252'zere ) ilgili yasalar '#231'er'#231'evesinde izin verilen a' +
        'zami '#246'l'#231#252'de s'#246'zle'#351'me h'#252'k'#252'mleri uyar'#305'nca veya kas'#305't, ihmal veya s' +
        'orumluluk '
      'nedeni ile olsa dahi sorumluluktan muaft'#305'r.'
      
        '7. YAZILIM g'#252'ncellenmeden '#246'nce (DATA) dizini mutlaka yedeklenmel' +
        'idir. Bu i'#351'lem g'#252'ncelleme s'#305'ras'#305'nda meydana gelecek ola'#287'and'#305#351#305' h' +
        'atalar'#305' '#246'nler. Bu i'#351'lemin yap'#305'lmamas'#305'ndan do'#287'acak veri '
      'kay'#305'plar'#305'ndan GRAN'#304'T sorumlu de'#287'ildir.'
      
        '8. YAZILIM geli'#351'mi'#351' bir yedekleme sistemine sahiptir. Bu sistemi' +
        'n kullan'#305'lmamas'#305'ndan veya yanl'#305#351' kullan'#305'm'#305'ndan do'#287'acak veri kay'#305 +
        'plar'#305'ndan GRAN'#304'T sorumlu de'#287'ildir.'
      
        '9. GRAN'#304'T, YAZILIM'#39' '#305'n kullan'#305'm'#305' esnas'#305'nda, teknik servis deste'#287 +
        'inin GRAN'#304'T yetkili elemanlar'#305' harici herhangi bir '#252#231#252'nc'#252' ger'#231'ek' +
        '/t'#252'zel ki'#351'iden almas'#305'ndan dolay'#305' meydana gelebilecek zararlardan' +
        ' '
      'sorumlu de'#287'ildir.'
      
        '10. GRAN'#304'T, YAZILIM ve dok'#252'mantasyonda de'#287'i'#351'iklik yapabilir. Kul' +
        'lan'#305'c'#305' dilerse, GRAN'#304'T'#39' in Lisans Sisteminde yer alan kurallar '#231 +
        'er'#231'evesinde bu yeni s'#252'r'#252'mden yararlanabilir. Bu noktada GRAN'#304'T '
      
        'eski s'#252'r'#252'm ile girilmi'#351' verilerin yeni s'#252'r'#252'm ile uyu'#351'aca'#287#305' taahh' +
        #252'd'#252'n'#252' vermez.'
      
        '11. YAZILIM ve dok'#252'mantasyonunun ve varsa, sizin taraf'#305'n'#305'zdan '#231#305 +
        'kar'#305'lm'#305#351' olan t'#252'm kopyalar'#305'n, i'#351'leme, geli'#351'tirme, yayma ve '#231'o'#287'al' +
        'tma, temsil ve iletme haklar'#305' m'#252'nhas'#305'ran GRAN'#304'T'#39' e aittir. '
      
        'YAZILIM'#39' '#305'n tamam'#305'n'#305'n veya bir k'#305'sm'#305'n'#305'n i'#351'lenerek geli'#351'tirilmesi' +
        ' durumunda olu'#351'turulan yeni eserin fikri m'#252'lkiyet hakk'#305' GRAN'#304'T'#39' ' +
        'e ait olup, GRAN'#304'T ayr'#305'ca ilgililer hakk'#305'nda herhangi bir ihtara' +
        ' gerek '
      
        'kalmaks'#305'z'#305'n her t'#252'rl'#252' yasal yollara ba'#351'vurma hakk'#305'na haizdir. YA' +
        'ZILIM'#39' '#305'n ve dok'#252'mantasyonun telif haklar'#305' 5846 say'#305'l'#305' Fikir ve ' +
        'Sanat Eserleri Kanunu ve T'#252'rk Ceza Kanunu h'#252'k'#252'mleri ile koruma a' +
        'lt'#305'na '
      'al'#305'nm'#305#351't'#305'r.'
      'IV- Genel H'#252'k'#252'mler'
      
        '1. '#304#351' bu s'#246'zle'#351'me konusu YAZILIM'#39' '#305'n de'#287'i'#351'tirilmesi veya geli'#351'ti' +
        'rilip yenilenmesi durumunda, i'#351' bu s'#246'zle'#351'me h'#252'k'#252'mleri, taraflar ' +
        'aras'#305'nda akdedilen yeni s'#246'zle'#351'me ile ortadan kald'#305'r'#305'lmad'#305#287#305' s'#252're' +
        'ce '
      'ge'#231'erlidir.'
      
        '2. '#39'SON KULLANICI'#39', i'#351' s'#246'zle'#351'me konusu '#252'r'#252'n'#252'n tam ve eksiksiz ol' +
        'mad'#305#287#305' '#252'r'#252'n'#252'n teslimi tarihinde a'#231#305'k'#231'a belirli ise, keyfiyeti, 2' +
        ' g'#252'n i'#231'inde, yaz'#305'l'#305' olarak GRAN'#304'T'#39' e bildirmesi ve 8 g'#252'n i'#231'inde ' +
        #252'r'#252'n'#252' '
      
        'muayene ettirmesi halinde; '#252'r'#252'n'#252'n de'#287'i'#351'tirilmesini, iadesini vey' +
        'a onar'#305'm'#305'n'#305' isteme se'#231'imlik haklar'#305'na haizdir.'
      
        '3. '#39'SON KULLANICI'#39', madde II/3. de yer alan haller d'#305#351#305'nda ay'#305'b'#305 +
        ', '#252'r'#252'n'#252'n teslimi tarihinden itibaren 30 g'#252'n i'#231'inde, GRAN'#304'T'#39' e bi' +
        'ldirmesi durumunda, GRAN'#304'T'#39' den '#252'r'#252'n'#252'n de'#287'i'#351'tirilmesi, ay'#305'p oran' +
        #305'nda '
      
        'bedelin indirilmesi, '#252'r'#252'n'#252'n iadesi veya '#252'cretsiz onar'#305'm isteme h' +
        'aklar'#305'na sahiptir.'
      
        '4. Bu Lisans S'#246'zle'#351'mesi'#39' nin maddelerine g'#246're bu YAZILIM'#39' '#305' kull' +
        'anma lisans'#305'; YAZILIM'#39' '#305'n, '#246'deme yapt'#305#287#305'n'#305'z bir sabit s'#252're, bir ' +
        's'#305'n'#305'rl'#305' s'#252're veya bir kira lisans'#305' kar'#351#305'l'#305#287#305'nda verildi'#287'i belirt' +
        'ilmemi'#351'se, '
      's'#252'reklidir.'
      
        '5. '#304#351' bu s'#246'zle'#351'menin uygulanmas'#305'nda kar'#351#305'l'#305'kl'#305' iyi niyet esast'#305'r' +
        '.'
      
        '6. A'#231#305'k'#231'a '#39'SON KULLANICI'#39' ya verildi'#287'i belirtilmeyen t'#252'm haklar ' +
        'GRAN'#304'T'#39' e aittir.'
      
        '7. Di'#287'er haklar'#305'n sakl'#305' kalmas'#305' kayd'#305'yla bu s'#246'zle'#351'menin '#351'artlar'#305 +
        'na uymaman'#305'z durumunda GRAN'#304'T s'#246'zle'#351'meyi sona erdirebilir.'
      
        '8. '#304#351' bu s'#246'zle'#351'menin uygulanmas'#305'ndan do'#287'an uyu'#351'mazl'#305'klarda, '#304'sta' +
        'nbul Mahkeme ve '#304'cra Daireleri yetkilidir.'
      ''
      #220'retici '
      'Genyaz'#305'l'#305'm (Feta Bilgisayar Ltd.'#350'ti)'
      'feta@feta.com.tr'
      'Distrib'#252't'#246'r'
      'Granit Bilgisayar '#304'leti'#351'im Ve Destek Hiz.San.Tic.Ltd..'#350'ti.'
      'granit@granit.com.tr'
      '')
    Style.BorderStyle = ebs3D
    Style.TransparentBorder = True
    TabOrder = 0
    Height = 472
    Width = 965
  end
end
