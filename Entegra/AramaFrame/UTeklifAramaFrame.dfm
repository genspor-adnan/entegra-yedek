  object TabSK: TFDQuery
    Connection = Tablo.FDCnn
        ParamData = <>
    SQL.Strings = (
      'select null as ID, null as KONUSU'
      'union all '
      
        'select SIRANO as ID, ANAHTAR as KONUSU from REHBERINI where BOLU' +
        'M='#39'Teklif_Konusu'#39' order by 2')
