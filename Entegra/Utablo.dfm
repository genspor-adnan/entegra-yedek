  object TabYetki: TFDQuery
    AfterOpen = TabYetkiAfterOpen
    Connection = FDCnn
    SQL.Strings = (
      'select M.MODULID,TUR=1,ROLID=:PRolID,Y.HAK,Y.BILGI'
      'FROM'
      #9'[dbo].[fn_ModulListesi]() M left outer join'
      #9'YETKI Y on'
      #9#9'Y.MODULID=M.MODULID and'
      #9#9'isnull(Y.ROLID,:PRolID)=:PRolID and'
      #9#9'Y.TUR=1'
      'where M.TUR in(1,2,3,4,6,7,8,9,16,17,18,19)'
      ''
      'union all'
      ''
      'select M.MODULID,TUR=2,ROLID=:PRolID,Y.HAK,Y.BILGI'
      'FROM'
      #9'[dbo].[fn_ModulListesi]() M left outer join'
      #9'YETKI Y on'
      #9#9'Y.MODULID=M.MODULID and'
      #9#9'isnull(Y.ROLID,:PRolID)=:PRolID and'
      #9#9'Y.TUR=2'
      'where M.TUR in(2,4,7,9,17,19)'
      ''
      'union all'
      ''
      'select M.MODULID,TUR=3,ROLID=:PRolID,Y.HAK,Y.BILGI'
      'FROM'
      #9'[dbo].[fn_ModulListesi]() M left outer join'
      #9'YETKI Y on'
      #9#9'Y.MODULID=M.MODULID and'
      #9#9'isnull(Y.ROLID,:PRolID)=:PRolID and'
      #9#9'Y.TUR=3'
      'where M.TUR in(3,4,8,9,18,19)'
      'union all'
      ''
      'select M.MODULID,TUR=4,ROLID=:PRolID,Y.HAK,Y.BILGI'
      'FROM'
      #9'[dbo].[fn_ModulListesi]() M left outer join'
      #9'YETKI Y on'
      #9#9'Y.MODULID=M.MODULID and'
      #9#9'isnull(Y.ROLID,:PRolID)=:PRolID and'
      #9#9'Y.TUR=4'
      'where M.TUR in(19)'
      '')
    Left = 1003
    Top = 141
