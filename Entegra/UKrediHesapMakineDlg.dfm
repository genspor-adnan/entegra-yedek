  object MemoSQLKredi: TMemo
    Left = 48
    Top = 247
    Width = 617
    Height = 73
    Lines.Strings = (
      '--Ay      TAKSIT Ana Para Faiz KKDF BSMV Bakiye '
      
        ' --1 . Ay 466.51 377.38 77.50 7.75 3.88 4,622.62                ' +
        '        '
      'DECLARE @TAKSITSAY SMALLINT,    '
      '@I SMALLINT,                   '
      '@BASLANGIC SMALLDATETIME,     '
      '@TAKSIT MONEY, @ANAPARA MONEY, @BAKIYE MONEY,                 '
      '@KUR VARCHAR(5),  '
      
        '@TOPFAIZORANI FLOAT,@FAIZORANI FLOAT, @FAIZ FLOAT,@KKDFORANI FLO' +
        'AT,@KKDF '
      'FLOAT,@BSMVORANI FLOAT, @BSMV FLOAT,'
      '@YENITARIH'#9'DATETIME,'
      '@ONCESONRA'#9'SMALLINT,'
      '@TATILKNTRL'#9'BIT            '
      '   '
      
        ' SQLKOMUT                                                       ' +
        '  '
      
        '--                           SET @TAKSITSAY=36 --IntToStr(TAKSIT' +
        'SAYSay.Value)+'#39'                                  '
      
        '--                           SET @BASLANGIC= '#39'2009-10-01'#39'--'#39#39'For' +
        'matdatetime('#39'yyyy-mm-dd'#39',DateTimePickerOdemeBasl.Date)+'#39#39#39'      ' +
        '  '
      
        '--                           SET @BAKIYE= 550000 --EditFaturaTAK' +
        'SIT.Text+'#39'   '
      
        '--                           SET @KUR= '#39'TL'#39'--'#39#39'ComboKurFat.Text+' +
        #39#39#39'              '
      '--                           SET @FAIZORANI = 1.07 ---'
      '--                           SET @BSMVORANI = 5 ---'
      '--                           SET @KKDFORANI = 0 --'
      '--                           SET @ONCESONRA = 1  '
      '                           '
      '                           SET @I=0                          '
      '                           set @TOPFAIZORANI = (@FAIZORANI  '
      '+(@FAIZORANI*@BSMVORANI/100)+(@FAIZORANI*@KKDFORANI/100))/100'
      
        '                           set @TAKSIT =  (POWER(1+  @TOPFAIZORA' +
        'NI , @TAKSITSAY) * '
      '@TOPFAIZORANI)/(POWER(1+@TOPFAIZORANI, @TAKSITSAY) - 1)*@BAKIYE'
      '                                                             '
      '                          CREATE TABLE #GECICIODEME          '
      '                           ( SOZID'#9'INT,                      '
      '                             TARIH SMALLDATETIME,            '
      
        '                            TAKSIT MONEY, ANAPARA MONEY, FAIZ FL' +
        'OAT,  KKDF FLOAT, BSMV FLOAT, BAKIYE MONEY,              '
      '                            KUR VARCHAR(5),                  '
      '                             ACIKLAMA VARCHAR(50)            '
      '                           )                                 '
      
        '                          WHILE @I <= @TAKSITSAY -1             ' +
        '                                                       '
      '                         BEGIN  '
      
        '                            set @FAIZ = (@BAKIYE*@FAIZORANI)/(10' +
        '0)'
      '                            set @BSMV = @FAIZ * @BSMVORANI / 100'
      '                            set @KKDF = @FAIZ * @KKDFORANI / 100'
      
        '                            set @ANAPARA = @TAKSIT - @FAIZ - @BS' +
        'MV - @KKDF                                                      ' +
        '                  '
      '                            set @BAKIYE = @BAKIYE - @ANAPARA  '
      '                            '
      
        '                            select @YENITARIH = DATEADD(month, @' +
        'I, @BASLANGIC)'
      '                            if @ONCESONRA<>0 '
      '                            BEGIN'
      #9#9#9#9#9#9#9#9'if exists(select * from REHBERINI where '
      'BOLUM = '#39'ResmiTatiller'#39' AND DEGER = '
      #9#9#9#9#9#9#9#9'CONVERT(varchar(10),@YENITARIH,103)) or '
      'DATENAME(WEEKDAY,@YENITARIH) IN ('#39'Saturday'#39','#39'Sunday'#39')'
      #9#9#9#9#9#9#9#9'BEGIN'
      #9#9#9#9#9#9#9#9#9'set @TATILKNTRL = 1'
      #9#9#9#9#9#9#9#9#9'while @TATILKNTRL = 1'
      #9#9#9#9#9#9#9#9#9'BEGIN'
      #9#9#9#9#9#9#9#9#9#9'select @YENITARIH = '
      'DATEADD(day, @ONCESONRA, @YENITARIH)  '
      #9#9#9#9#9#9#9#9#9#9'if exists(select * from '
      'REHBERINI where BOLUM = '#39'ResmiTatiller'#39' AND'
      #9#9#9#9#9#9#9#9#9#9'   DEGER = '
      
        'CONVERT(varchar(10),@YENITARIH,103)) or DATENAME(WEEKDAY,@YENITA' +
        'RIH) IN ('#39'Saturday'#39','#39'Sunday'#39')'
      #9#9#9#9#9#9#9#9#9#9#9'set '
      '@TATILKNTRL = 1'
      #9#9#9#9#9#9#9#9#9#9'ELSE'
      #9#9#9#9#9#9#9#9#9#9#9'set '
      '@TATILKNTRL = 0'
      #9#9#9#9#9#9#9#9#9'END'
      #9#9#9#9#9#9#9#9'END'
      #9#9#9#9#9#9#9'END'
      
        '                                                                ' +
        '                                '
      
        '                            INSERT INTO #GECICIODEME (SOZID, TAR' +
        'IH, TAKSIT,ANAPARA,FAIZ, KKDF, BSMV,BAKIYE, KUR, '
      'ACIKLAMA )                        '
      '                            VALUES (1, @YENITARIH, '
      
        'ROUND(@TAKSIT,2),ROUND(@ANAPARA,2),ROUND(@FAIZ,2), ROUND(@KKDF,2' +
        '),ROUND(@BSMV,2),ROUND(@BAKIYE,2), '
      '@KUR, CONVERT(VARCHAR(10),@I+1)+'#39'. Taksit'#39') '
      
        '                            SET @I=@I+1                         ' +
        '                                                  '
      
        '                          END                                   ' +
        '                                                  '
      
        '                                                                ' +
        '                                                  '
      
        '                          select * from #GECICIODEME            ' +
        '                                                  '
      '                          drop table #GECICIODEME ;')
    TabOrder = 4
    Visible = False
  end
