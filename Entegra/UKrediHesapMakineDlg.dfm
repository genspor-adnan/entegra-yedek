  object MemoSQLLeasing: TMemo
    Left = 45
    Top = 342
    Width = 657
    Height = 73
    Lines.Strings = (
      
        '--Ay      TAKSIT Ana Para Faiz KKDF BSMV Bakiye drop TABLE #GECI' +
        'CIODEME          '
      
        ' --1 . Ay 466.51 377.38 77.50 7.75 3.88 4,622.62                ' +
        '        '
      'DECLARE @TAKSITSAY SMALLINT,    '
      '@I SMALLINT,                   '
      '@BASLANGIC SMALLDATETIME,     '
      
        '@TAKSIT MONEY,@KDVSIZ MONEY, @ANAPARA MONEY, @BAKIYE MONEY,@KALI' +
        'NTI MONEY,                 '
      '@KUR VARCHAR(5),  '
      '@FAIZORANI FLOAT, @FAIZ FLOAT,@KDV FLOAT,'
      '@YENITARIH'#9'DATETIME,'
      '@ONCESONRA'#9'SMALLINT,@DONEM SMALLINT,'
      '@TATILKNTRL'#9'BIT,'
      '@SATIS MONEY'
      '   '
      'SQLKOMUT                                                       '
      
        '--SET @TAKSITSAY=12 --IntToStr(TAKSITSAYSay.Value)+'#39'            ' +
        '                      '
      
        '--SET @BASLANGIC= '#39'2009-10-27'#39'--'#39#39'Formatdatetime('#39'yyyy-mm-dd'#39',Da' +
        'teTimePickerOdemeBasl.Date)+'#39#39#39'        '
      '--SET @BAKIYE= 100000.0 --EditFaturaTAKSIT.Text+'#39'   '
      '--SET @KUR= '#39'TL'#39'--'#39#39'ComboKurFat.Text+'#39#39#39'              '
      '--SET @FAIZORANI = 18.37 ---0.0167  ---0.20'
      '--SET @KDV = 8'
      '--SET @TATILKNTRL = 0'
      
        '--SET @ONCESONRA = 1 -- -1 : onceki g'#252'nlere gider, 1: sonraki g'#252 +
        'nlere gider'
      '--SET @DONEM = 1'
      '--SET @SATIS = 100'
      ''
      
        '                           -- i = n * ( [ (1+r)^(1/n) ] - 1 ), n' +
        'ominal faiz hesaplama'
      '                           --  (1+i / n)^n - 1'
      
        '                           -- PMT = L[c(1 + c)^n]/[(1 + c)^n - 1' +
        ']'
      '                           '
      '                           SET @I=0                         '
      '                           set @FAIZORANI = @FAIZORANI / 100.0'
      
        '                           if @DONEM = 0 begin --d'#246'nemba'#351#305' form'#252 +
        'l'#252
      #9#9'  set @KALINTI = 0.0 '
      
        #9#9'  set @TAKSIT = (@BAKIYE-@KALINTI/power((1+@FAIZORANI/12),@TAK' +
        'SITSAY))'
      
        '/((1-power((1+@FAIZORANI/12),(-(@TAKSITSAY-1))))/(@FAIZORANI/12)' +
        '+1) '
      '          set @TAKSITSAY = @TAKSITSAY - 1'
      '          set @BAKIYE=@BAKIYE - @TAKSIT'
      #9#9#9#9#9#9'   end else'
      
        #9#9#9#9#9#9'   begin --d'#246'nemsonu form'#252'l'#252' : c = (r / (1 - (1 + r) - N))' +
        'P '
      #9#9#9#9#9#9'   --   =(6.5/100/12)/(1-(1+6.5/100/12)^(-30*12))*200000'
      ''
      
        '                              set @FAIZORANI = @FAIZORANI  / 12.' +
        '0'
      
        '                              set @TAKSIT = @FAIZORANI / (1.0-PO' +
        'WER(1.0+@FAIZORANI, -1*@TAKSITSAY))*@BAKIYE'
      '                              '
      #9#9#9#9#9#9'   end'
      #9#9#9#9#9#9'   '#9' '
      '                           set @KDVSIZ = @TAKSIT'
      
        '                           set @TAKSIT = @TAKSIT * (1.0+(@KDV / ' +
        '100.0))'
      '                          CREATE TABLE #GECICIODEME          '
      '                           ( SOZID'#9'INT,                      '
      '                             TARIH SMALLDATETIME,            '
      
        '                            TAKSIT MONEY, KDVSIZ MONEY, ANAPARA ' +
        'MONEY, FAIZ FLOAT, BAKIYE MONEY,              '
      '                            KUR VARCHAR(5),                  '
      '                             ACIKLAMA VARCHAR(50)            '
      '                           )                                 '
      
        '                          WHILE @I <= @TAKSITSAY -1             ' +
        '                                                       '
      '                         BEGIN  '
      
        '                            --set @FAIZ = (@BAKIYE*@FAIZORANI)/(' +
        '100)'
      
        '                            set @FAIZ = (@BAKIYE*@FAIZORANI/12) ' +
        '                                          '
      
        '                            set @ANAPARA = @KDVSIZ - @FAIZ      ' +
        '                                                                ' +
        '   '
      
        '                            set @BAKIYE = @BAKIYE - @ANAPARA    ' +
        '                                                                ' +
        '  '
      
        '                            select @YENITARIH = DATEADD(month, @' +
        'I, @BASLANGIC)'
      '                            '
      '                            if @ONCESONRA<>0 '
      '                            BEGIN'
      #9#9#9#9#9#9#9#9'if exists(select * from REHBERINI where '
      'BOLUM = '#39'ResmiTatiller'#39' AND DEGER = '
      #9#9#9#9#9#9#9#9#9#9
      
        'CONVERT(varchar(10),@YENITARIH,103)) or DATENAME(WEEKDAY,@YENITA' +
        'RIH) IN ('#39'Saturday'#39','#39'Sunday'#39')'
      #9#9#9#9#9#9#9#9'BEGIN'
      #9#9#9#9#9#9#9#9#9'set @TATILKNTRL = 1'
      #9#9#9#9#9#9#9#9#9'while @TATILKNTRL = 1'
      #9#9#9#9#9#9#9#9#9'BEGIN'
      #9#9#9#9#9#9#9#9#9#9'select @YENITARIH = '
      'DATEADD(day, @ONCESONRA, @YENITARIH)  '
      #9#9#9#9#9#9#9#9#9#9'if exists(select * from '
      'REHBERINI where BOLUM = '#39'ResmiTatiller'#39' AND'
      #9#9#9#9#9#9#9#9#9#9'   DEGER = '
      
        'CONVERT(varchar(10),@YENITARIH,103)) or DATENAME(WEEKDAY,@YENITA' +
        'RIH) IN ('#39'Saturday'#39','#39'Sunday'#39')'
      #9#9#9#9#9#9#9#9#9#9#9'set '
      '@TATILKNTRL = 1'
      #9#9#9#9#9#9#9#9#9#9'ELSE'
      #9#9#9#9#9#9#9#9#9#9#9'set '
      '@TATILKNTRL = 0'
      #9#9#9#9#9#9#9#9#9'END'
      #9#9#9#9#9#9#9#9'END'
      #9#9#9#9#9#9#9'END'
      '                            '
      
        '                           INSERT INTO #GECICIODEME (SOZID, TARI' +
        'H, TAKSIT,KDVSIZ ,ANAPARA,FAIZ, BAKIYE, KUR, '
      'ACIKLAMA )                        '
      '                            VALUES (1,@YENITARIH, '
      
        'ROUND(@TAKSIT,2),ROUND(@KDVSIZ,2),ROUND(@ANAPARA,2),ROUND(@FAIZ,' +
        '2), ROUND(@BAKIYE,2), '
      '@KUR, CONVERT(VARCHAR(10),@I+1)+'#39'. Taksit'#39') '
      
        '                            SET @I=@I+1                         ' +
        '                                                  '
      '                          END         '
      
        '                                                                ' +
        '            '
      '--sat'#305#351' sat'#305'r'#305'n'#305' da ekleyelim                            '
      
        'select @YENITARIH = DATEADD(month, @I, @BASLANGIC)              ' +
        '                  '
      
        'INSERT INTO #GECICIODEME (SOZID, TARIH, TAKSIT,KDVSIZ ,ANAPARA,F' +
        'AIZ, BAKIYE, KUR, ACIKLAMA )                        '
      
        'VALUES (1,@YENITARIH, ROUND(@SATIS*(100.0+@KDV)/100.0,2),ROUND(@' +
        'SATIS,2),ROUND(@SATIS,2),0.0,0.0, '
      '@KUR,'#39'Sat'#305#351#39') '
      
        '                                                                ' +
        '                      '
      
        '                          select * from #GECICIODEME            ' +
        '                                                  '
      '                          drop table #GECICIODEME ;')
    TabOrder = 5
    Visible = False
  end
